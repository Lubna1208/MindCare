@model MindCare.ViewModels.CreateForumPostViewModel

@{
    ViewData["Title"] = "Create Forum Post";
}

<section class="mc-forum-create-page" aria-labelledby="forum-create-title">
    <header class="mc-forum-create-header">
        <div>
            <p>Community</p>
            <h1 id="forum-create-title">Create Forum Post</h1>
            <span>Share what is on your mind with the community.</span>
        </div>
    </header>

    <form asp-action="Create" method="post" class="mc-forum-create-card" data-forum-create-form>
        <div class="mc-forum-create-anonymity"><span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3 5.5 6v5.2c0 4.25 2.73 7.75 6.5 9.3 3.77-1.55 6.5-5.05 6.5-9.3V6L12 3Z"/><path d="m9.5 12.1 1.7 1.9 3.5-4"/></svg></span><p>Posts are displayed anonymously in the community.</p></div>
        <p class="mc-forum-create-card-label">Start a conversation</p>
        <div asp-validation-summary="ModelOnly" class="mc-forum-create-validation" role="alert"></div>

        <div class="mc-forum-create-field">
            <label asp-for="Title">Post title</label>
            <input asp-for="Title" class="mc-forum-create-input" maxlength="120" placeholder="Give your post a clear title" aria-describedby="title-count" />
            <div class="mc-forum-create-field-meta"><span asp-validation-for="Title" class="mc-forum-create-field-error"></span><span id="title-count" data-forum-counter="Title" aria-live="polite">@(Model.Title?.Length ?? 0) / 120</span></div>
        </div>

        <div class="mc-forum-create-field">
            <label asp-for="Content">What would you like to share?</label>
            <textarea asp-for="Content" class="mc-forum-create-textarea" rows="8" maxlength="3000" placeholder="Write your post here..." aria-describedby="content-help content-count"></textarea>
            <p id="content-help" class="mc-forum-create-help">Avoid sharing personal identifying information.</p>
            <div class="mc-forum-create-field-meta"><span asp-validation-for="Content" class="mc-forum-create-field-error"></span><span id="content-count" data-forum-counter="Content" aria-live="polite">@(Model.Content?.Length ?? 0) / 3000</span></div>
        </div>

        <div class="mc-forum-create-actions">
            <button type="submit" class="mc-forum-create-submit"><span data-forum-submit-label>Create Post</span></button>
            <a asp-action="Index" class="mc-forum-create-back">← Back to Forum</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('[data-forum-counter]').forEach(function (counter) {
            var input = document.getElementById(counter.dataset.forumCounter);
            if (!input) return;
            var updateCount = function () { counter.textContent = input.value.length + ' / ' + input.maxLength; };
            input.addEventListener('input', updateCount);
            updateCount();
        });

        document.querySelectorAll('[data-forum-create-form]').forEach(function (form) {
            form.addEventListener('submit', function (event) {
                if (event.defaultPrevented || !this.checkValidity()) return;
                var button = this.querySelector('button[type="submit"]');
                var label = this.querySelector('[data-forum-submit-label]');
                if (!button || button.disabled) return;
                button.disabled = true;
                if (label) label.textContent = 'Creating...';
            });
        });
    </script>
}
