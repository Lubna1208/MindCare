@model MindCare.ViewModels.ForumPostDetailsViewModel
@using System.Security.Claims

@{
    ViewData["Title"] = Model.Post.Title;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var commentCount = Model.Post.Comments.Count;
}

<section class="mc-forum-detail-page" aria-labelledby="forum-discussion-title">
    <header class="mc-forum-detail-header">
        <div>
            <p>Community</p>
            <h1 id="forum-discussion-title">Discussion</h1>
            <span class="mc-forum-detail-anonymity"><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3 5.5 6v5.2c0 4.25 2.73 7.75 6.5 9.3 3.77-1.55 6.5-5.05 6.5-9.3V6L12 3Z"/><path d="m9.5 12.1 1.7 1.9 3.5-4"/></svg></i>Posts and comments are shown anonymously.</span>
        </div>
        <a asp-action="Index" class="mc-forum-detail-back">← Back to Forum</a>
    </header>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="mc-forum-detail-alert mc-forum-detail-alert--success" role="status" data-auto-dismiss="5000">@successMessage</div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="mc-forum-detail-alert mc-forum-detail-alert--error" role="alert">@errorMessage</div>
    }

    <article class="mc-forum-detail-post">
        <header class="mc-forum-detail-post-header">
            <div><h2>@Model.Post.Title</h2><p>Anonymous User <span aria-hidden="true">·</span> @Model.Post.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")</p></div>
            @if (Model.Post.UserId == currentUserId)
            {
                <form asp-action="DeletePost" asp-route-id="@Model.Post.Id" method="post"><button type="submit" class="mc-forum-detail-delete">Delete</button></form>
            }
        </header>
        <div class="mc-forum-detail-post-content">@Model.Post.Content</div>

        @if (Model.Post.UserId != currentUserId)
        {
            <form asp-action="Report" method="post" class="mc-forum-detail-report">
                <div asp-validation-summary="ModelOnly" class="mc-forum-detail-field-error" role="alert"></div>
                <input type="hidden" name="PostId" value="@Model.Post.Id" />
                <label for="post-report-reason">Report post</label>
                <textarea id="post-report-reason" name="Reason" rows="2" maxlength="500" required></textarea>
                <button type="submit">Report</button>
            </form>
        }
    </article>

    <section class="mc-forum-detail-comments" aria-labelledby="forum-comments-title">
        <header><h2 id="forum-comments-title">Comments <span>· @commentCount</span></h2></header>
        @if (commentCount == 0)
        {
            <div class="mc-forum-detail-comments-empty"><span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20 15a4 4 0 0 1-4 4H9l-5 3v-7a4 4 0 0 1-2-3.5V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4v8Z"/><path d="M7 10h.01M12 10h.01M17 10h.01"/></svg></span><div><strong>No comments yet</strong><p>Be the first to join the conversation.</p></div></div>
        }
        else
        {
            <div class="mc-forum-detail-comment-list">
                @foreach (var comment in Model.Post.Comments)
                {
                    <article class="mc-forum-detail-comment">
                        <header><p>Anonymous User <span aria-hidden="true">·</span> @comment.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")</p>
                        @if (comment.UserId == currentUserId)
                        {
                            <form asp-action="DeleteComment" asp-route-id="@comment.Id" method="post"><button type="submit" class="mc-forum-detail-delete">Delete</button></form>
                        }</header>
                        <div>@comment.Content</div>
                        @if (comment.UserId != currentUserId)
                        {
                            <form asp-action="Report" method="post" class="mc-forum-detail-report mc-forum-detail-report--comment">
                                <input type="hidden" name="CommentId" value="@comment.Id" />
                                <label for="comment-report-reason-@comment.Id">Report comment</label>
                                <textarea id="comment-report-reason-@comment.Id" name="Reason" rows="2" maxlength="500" required></textarea>
                                <button type="submit">Report</button>
                            </form>
                        }
                    </article>
                }
            </div>
        }
    </section>

    <section class="mc-forum-detail-composer" aria-labelledby="add-comment-title">
        <header><p>Add a comment</p><h2 id="add-comment-title">Join the conversation</h2></header>
        <form asp-action="AddComment" asp-route-postId="@Model.Post.Id" method="post" data-forum-comment-form>
            <label asp-for="CommentForm.Content">Comment</label>
            <textarea asp-for="CommentForm.Content" name="Content" rows="5" maxlength="1000" placeholder="Write a supportive comment..." aria-describedby="comment-help comment-count"></textarea>
            <p id="comment-help" class="mc-forum-detail-comment-help">Your comment will appear anonymously.</p>
            <div class="mc-forum-detail-comment-meta"><span asp-validation-for="CommentForm.Content" class="mc-forum-detail-field-error"></span><span id="comment-count" aria-live="polite">@(Model.CommentForm.Content?.Length ?? 0) / 1000</span></div>
            <button type="submit" class="mc-forum-detail-comment-submit"><span data-forum-comment-label>Post Comment</span></button>
        </form>
    </section>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var commentInput = document.getElementById('CommentForm_Content');
        var commentCount = document.getElementById('comment-count');
        if (commentInput && commentCount) {
            var updateCommentCount = function () { commentCount.textContent = commentInput.value.length + ' / ' + commentInput.maxLength; };
            commentInput.addEventListener('input', updateCommentCount);
            updateCommentCount();
        }
        document.querySelectorAll('[data-forum-comment-form]').forEach(function (form) {
            form.addEventListener('submit', function (event) {
                if (event.defaultPrevented || !this.checkValidity()) return;
                var button = this.querySelector('button[type="submit"]');
                var label = this.querySelector('[data-forum-comment-label]');
                if (!button || button.disabled) return;
                button.disabled = true;
                if (label) label.textContent = 'Posting...';
            });
        });
    </script>
}
