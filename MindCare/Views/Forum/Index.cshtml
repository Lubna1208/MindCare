@model IReadOnlyList<MindCare.Models.ForumPost>
@using System.Security.Claims

@{
    ViewData["Title"] = "Community Forum";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="mc-forum-page">
    <header class="mc-forum-header">
        <div class="mc-forum-header-copy">
            <p class="mc-forum-eyebrow">Community</p>
            <h1>Community Forum</h1>
            <p class="mc-forum-privacy-note">
                <span class="mc-forum-privacy-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3 5.5 6v5.2c0 4.25 2.73 7.75 6.5 9.3 3.77-1.55 6.5-5.05 6.5-9.3V6L12 3Z"/><path d="M9.5 12.1 11.2 14l3.5-4"/></svg></span>
                Posts and comments are shown anonymously.
            </p>
        </div>
        <a asp-action="Create" class="mc-forum-create"><span aria-hidden="true">+</span> Create Post</a>
    </header>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="mc-forum-alert mc-forum-alert--success" role="status" data-auto-dismiss="5000">@successMessage</div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="mc-forum-alert mc-forum-alert--error" role="alert">@errorMessage</div>
    }

    @if (!Model.Any())
    {
        <section class="mc-forum-empty" aria-labelledby="forum-empty-heading">
            <span class="mc-forum-empty-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M5 18.5a3.5 3.5 0 0 1-1.5-2.9V7.8A3.8 3.8 0 0 1 7.3 4h9.4a3.8 3.8 0 0 1 3.8 3.8v7.8a3.8 3.8 0 0 1-3.8 3.8H9l-4 2.6v-3.5Z"/><path d="M8 11.5h8M8 15h5"/></svg></span>
            <h2 id="forum-empty-heading">No posts yet</h2>
            <p>Start a conversation or share what is on your mind.</p>
            <a asp-action="Create" class="mc-forum-create"><span aria-hidden="true">+</span> Create Post</a>
        </section>
    }
    else
    {
        <p class="mc-forum-feed-label">Recent discussions</p>
        <div class="mc-forum-feed">
            @foreach (var post in Model)
            {
                var commentCount = post.Comments.Count;
                <article class="mc-forum-post mc-forum-post-card">
                    <header class="mc-forum-post-header">
                        <div class="mc-forum-post-heading">
                            <h2 class="mc-forum-post-title">@post.Title</h2>
                            <p class="mc-forum-post-meta">Anonymous User <span aria-hidden="true">&bull;</span> @post.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")</p>
                        </div>
                    </header>

                    <div class="mc-forum-post-body">@post.Content</div>

                    <div class="mc-forum-post-actions">
                        <a asp-action="Details" asp-route-id="@post.Id" class="mc-forum-view-post">View Discussion <span aria-hidden="true">&rarr;</span></a>
                        @if (post.UserId == currentUserId)
                        {
                            <form asp-action="DeletePost" asp-route-id="@post.Id" method="post">
                                <button type="submit" class="mc-forum-delete mc-forum-owner-delete">Delete</button>
                            </form>
                        }
                    </div>

                    <section class="mc-forum-comments" aria-label="Comments for @post.Title">
                        <div class="mc-forum-comments-header"><span>Comments</span><span aria-label="@commentCount comments">@commentCount</span></div>
                        @if (commentCount == 0)
                        {
                            <p class="mc-forum-no-comments">No comments yet. Be the first to join the conversation.</p>
                        }
                        else
                        {
                            <div class="mc-forum-comment-preview-list">
                                @foreach (var comment in post.Comments.Take(2))
                                {
                                    <div class="mc-forum-comment-preview">
                                        <p class="mc-forum-comment-meta">Anonymous User <span aria-hidden="true">&bull;</span> @comment.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")</p>
                                        <div class="mc-forum-comment-content">@comment.Content</div>
                                        @if (comment.UserId == currentUserId)
                                        {
                                            <form asp-action="DeleteComment" asp-route-id="@comment.Id" method="post"><button type="submit" class="mc-forum-delete mc-forum-owner-delete mc-forum-delete--comment">Delete comment</button></form>
                                        }
                                    </div>
                                }
                            </div>
                            @if (commentCount > 2)
                            {
                                <a asp-action="Details" asp-route-id="@post.Id" class="mc-forum-all-comments">View all @commentCount comments <span aria-hidden="true">&rarr;</span></a>
                            }
                        }
                    </section>
                </article>
            }
        </div>
    }
</div>
