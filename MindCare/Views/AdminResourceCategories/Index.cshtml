@model IEnumerable<MindCare.Models.ResourceCategory>
@{
    ViewData["Title"] = "Resource Categories";
    var totalCount = Model.Count();
    var activeCount = Model.Count(c => c.IsActive);
    var inactiveCount = totalCount - activeCount;
}
<section class="mc-resource-categories-page"><div class="mc-resource-categories-container">
    <header class="mc-category-header"><div><p>RESOURCE MANAGEMENT</p><h1>Resource Categories</h1><span>Organize resources into clear wellbeing categories.</span></div><a asp-controller="AdminResources" asp-action="Index" class="mc-category-back">← Back to Resources</a></header>
    <section class="mc-category-summary" aria-label="Category summary"><div><span>Total categories</span><strong>@totalCount</strong></div><div><span>Active</span><strong>@activeCount</strong></div><div><span>Inactive</span><strong>@inactiveCount</strong></div></section>
    <section class="mc-category-create-card" aria-labelledby="addCategoryTitle"><header><div><h2 id="addCategoryTitle">Add New Category</h2><p>Create a category that can be used to organize MindCare resources.</p></div></header>
        @if (TempData["ErrorMessage"] is string errorMessage) { <div class="mc-category-validation" role="alert" data-auto-dismiss="5000">@errorMessage</div> }
        <form asp-action="Save" method="post" class="mc-category-create-form">@Html.AntiForgeryToken()<div class="mc-category-field"><label for="categoryName">Category Name</label><span>Use a short, clear category name.</span><input id="categoryName" name="name" class="form-control" required maxlength="100" /></div><div class="mc-category-field"><label for="categoryDescription">Description <small>Optional</small></label><span>Briefly describe what resources belong in this category.</span><textarea id="categoryDescription" name="description" class="form-control" rows="2" maxlength="300"></textarea></div><div class="mc-category-create-action"><button class="mc-category-add-button" type="submit"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>Add Category</button></div></form>
    </section>
    <section class="mc-category-list-card" aria-labelledby="categoriesTitle"><header><div><h2 id="categoriesTitle">Categories</h2><p>Manage categories available for resource creation.</p></div><span>@totalCount @(totalCount == 1 ? "category" : "categories")</span></header>
        @if (!Model.Any()) { <div class="mc-category-empty"><h3>No categories have been created yet.</h3><p>Create your first resource category above.</p></div> }
        else { <div class="table-responsive mc-category-table-scroll"><table class="table mc-category-table"><thead><tr><th>Category</th><th>Description</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach (var c in Model) { <tr><td><strong>@c.Name</strong></td><td class="mc-category-description">@(string.IsNullOrWhiteSpace(c.Description) ? "No description" : c.Description)</td><td><span class="mc-category-status @(c.IsActive ? "mc-category-status--active" : "mc-category-status--inactive")">@(c.IsActive ? "Active" : "Inactive")</span></td><td><form asp-action="Toggle" asp-route-id="@c.Id" method="post">@Html.AntiForgeryToken()<button class="mc-category-toggle @(c.IsActive ? "mc-category-toggle--deactivate" : "mc-category-toggle--activate")">@(c.IsActive ? "Deactivate" : "Activate")</button></form></td></tr> }</tbody></table></div> }
    </section>
</div></section>
