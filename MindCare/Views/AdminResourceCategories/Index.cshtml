@model IEnumerable<MindCare.Models.ResourceCategory>
@{ ViewData["Title"]="Resource Categories"; }
<section class="mc-resources-page"><div class="mc-resources-container"><h1>Resource Categories</h1><form asp-action="Save" method="post" class="mc-resource-form">@Html.AntiForgeryToken()<label>Name</label><input name="name" class="form-control" required maxlength="100"/><label>Description</label><input name="description" class="form-control" maxlength="300"/><button class="btn mc-btn-primary mt-3">Add Category</button></form><div class="table-responsive"><table class="table"><thead><tr><th>Name</th><th>Description</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var c in Model){<tr><td>@c.Name</td><td>@c.Description</td><td>@(c.IsActive?"Active":"Inactive")</td><td><form asp-action="Toggle" asp-route-id="@c.Id" method="post">@Html.AntiForgeryToken()<button class="btn btn-link">@(c.IsActive?"Deactivate":"Activate")</button></form></td></tr>}</tbody></table></div></div></section>
