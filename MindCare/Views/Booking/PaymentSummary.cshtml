@model MindCare.ViewModels.PaymentSummaryViewModel

@{
    ViewData["Title"] = "Confirm and Pay";
    string FormatTime(TimeSpan time) => DateTime.Today.Add(time).ToString("h:mm tt");
    var counsellor = Model.Slot.CounsellorProfile.ApplicationUser;
    var profile = Model.Slot.CounsellorProfile;
    var counsellorInitial = string.IsNullOrWhiteSpace(counsellor.Name) ? "C" : counsellor.Name.Trim()[0].ToString().ToUpperInvariant();
    var amountDisplay = (Model.AmountMinorUnits / 100m).ToString("0");
    var selectedDate = Model.Slot.Date.ToString("yyyy-MM-dd");
}

<section class="mc-checkout-page" aria-labelledby="checkout-title">
    <header class="mc-checkout-hero">
        <p>Your appointment</p>
        <h1 id="checkout-title">Confirm and Pay</h1>
        <span>Review your appointment details before continuing to secure payment.</span>
    </header>

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="mc-checkout-alert" role="alert">@errorMessage</div>
    }

    <div class="mc-checkout-card">
        <div class="mc-checkout-details">
            <section class="mc-checkout-section" aria-labelledby="counsellor-title">
                <p class="mc-checkout-label" id="counsellor-title">Counsellor</p>
                <div class="mc-checkout-counsellor">
                    <span class="mc-checkout-avatar" aria-hidden="true">@counsellorInitial</span>
                    <div><h2>@counsellor.Name</h2><p>@profile.Specialization</p></div>
                </div>
            </section>

            <section class="mc-checkout-section mc-checkout-professional" aria-labelledby="professional-title">
                <p class="mc-checkout-label" id="professional-title">Professional details</p>
                <dl>
                    <div><dt>Qualification</dt><dd>@profile.Qualification</dd></div>
                    <div><dt>Experience</dt><dd>@profile.Experience</dd></div>
                    <div><dt>Phone</dt><dd>@profile.Phone</dd></div>
                </dl>
            </section>

            <section class="mc-checkout-section mc-checkout-appointment" aria-labelledby="appointment-title">
                <p class="mc-checkout-label" id="appointment-title">Appointment</p>
                <div class="mc-checkout-appointment-item"><span aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M7.5 3v4m9-4v4M3.5 10h17"/></svg></span><div><small>Date</small><strong>@Model.Slot.Date.ToString("dd MMMM yyyy")</strong></div></div>
                <div class="mc-checkout-appointment-item"><span aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="M12 7v5l3.5 2"/></svg></span><div><small>Time</small><strong>@FormatTime(Model.Slot.StartTime) – @FormatTime(Model.Slot.EndTime)</strong></div></div>
            </section>
        </div>

        <aside class="mc-checkout-payment" aria-labelledby="payment-title">
            <p class="mc-checkout-label" id="payment-title">Payment summary</p>
            <div class="mc-checkout-price-row"><span>Counselling appointment</span><strong>৳@amountDisplay</strong></div>
            <div class="mc-checkout-total"><span>Total</span><strong>৳@amountDisplay <small>BDT</small></strong></div>

            <form asp-action="CreateCheckoutSession" method="post" data-payment-form>
                <input type="hidden" name="slotId" value="@Model.SlotId" />
                <button type="submit" class="mc-checkout-submit"><span data-payment-label>Confirm Payment</span></button>
            </form>
            <p class="mc-checkout-stripe-note"><span aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="5.5" y="10" width="13" height="10" rx="2"/><path d="M8.5 10V7.5a3.5 3.5 0 0 1 7 0V10m-3.5 4v2"/></svg></span>You'll be securely redirected to Stripe to complete your payment.</p>
            <a asp-action="Index" asp-route-counsellorProfileId="@Model.Slot.CounsellorProfileId" asp-route-date="@selectedDate" class="mc-checkout-cancel">← Change appointment</a>
        </aside>
    </div>
</section>
