@model IReadOnlyList<MindCare.Models.Appointment>
@inject MindCare.Services.IAppointmentChatWindowService ChatWindowService

@{
    ViewData["Title"] = "My Appointments";
    string FormatTime(TimeSpan time) => DateTime.Today.Add(time).ToString("h:mm tt");
    bool CanOpenChat(Appointment appointment) =>
        (appointment.Status == AppointmentStatuses.Booked || appointment.Status == AppointmentStatuses.Confirmed) &&
        (appointment.PaymentStatus == PaymentStatuses.Paid || appointment.PaymentStatus == PaymentStatuses.Confirmed) &&
        ChatWindowService.IsOpen(appointment);
    var dateGroups = Model.GroupBy(appointment => appointment.Date.Date).OrderBy(group => group.Key).ToList();
    var highlightAppointmentId = ViewData["HighlightAppointmentId"] is int appointmentId ? appointmentId : (int?)null;
    var serverNow = ChatWindowService.GetCurrentLocalTime();
    var defaultOpenDate = dateGroups.FirstOrDefault(group => group.Key >= DateTime.Today)?.Key ?? dateGroups.FirstOrDefault()?.Key;
    var highlightedGroup = highlightAppointmentId.HasValue
        ? dateGroups.FirstOrDefault(group => group.Any(appointment => appointment.Id == highlightAppointmentId.Value))
        : null;
    if (highlightedGroup is not null)
    {
        defaultOpenDate = highlightedGroup.Key;
    }
}

<style>
    .mc-page { max-width: 900px; margin: 0 auto; }
    .mc-page h1 {
        font-family: var(--mc-font-heading, 'Lora', 'Playfair Display', serif);
        color: var(--mc-deep, #2F5D57);
    }
    .mc-empty-state {
        background: var(--mc-pale, #D9F5EF);
        border-radius: 16px;
        padding: 1.75rem;
        text-align: center;
        color: var(--mc-deep, #2F5D57);
        margin-bottom: 1.5rem;
    }
    .mc-appt-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
    }
    .mc-appt-card {
        background: #fff;
        border: 1px solid var(--mc-pale, #D9F5EF);
        border-radius: 16px;
        padding: 1.1rem 1.3rem;
        box-shadow: 0 6px 18px rgba(47, 93, 87, 0.05);
        transition: box-shadow 0.2s ease, transform 0.2s ease;
    }
    .mc-appt-card:hover {
        box-shadow: 0 8px 22px rgba(47, 93, 87, 0.09);
        transform: translateY(-1px);
    }
    .mc-appt-date {
        color: var(--mc-deep, #2F5D57);
        font-weight: 700;
        font-family: var(--mc-font-heading, 'Lora', 'Playfair Display', serif);
        font-size: 1.05rem;
    }
    .mc-appt-time {
        color: var(--mc-deep, #2F5D57);
        opacity: 0.8;
        font-size: 0.95rem;
    }
    .mc-appt-counsellor {
        margin-top: 0.5rem;
        color: var(--mc-deep, #2F5D57);
        opacity: 0.85;
        font-size: 0.95rem;
    }
    .mc-status-pill {
        display: inline-block;
        border-radius: 999px;
        padding: 0.28rem 0.85rem;
        font-weight: 600;
        font-size: 0.82rem;
        align-self: flex-start;
    }
    .mc-status-booked { background: var(--mc-soft, #A7E3D4); color: var(--mc-deep, #2F5D57); }
    .mc-status-completed { background: var(--mc-pale, #D9F5EF); color: var(--mc-deep, #2F5D57); }
    .mc-status-cancelled { background: #F3E3D3; color: #8A5A2B; }
    .mc-btn-primary {
        background: var(--mc-teal, #5BB9A6);
        border: none;
        color: #fff;
        border-radius: 999px;
        padding: 0.6rem 1.3rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        transition: background 0.2s ease, transform 0.2s ease;
    }
    .mc-btn-primary:hover { background: var(--mc-deep, #2F5D57); color: #fff; transform: translateY(-1px); }
    .mc-btn-outline {
        border: 1px solid var(--mc-deep, #2F5D57);
        color: var(--mc-deep, #2F5D57);
        background: transparent;
        border-radius: 999px;
        padding: 0.6rem 1.3rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        margin-left: 0.6rem;
        transition: background 0.2s ease, color 0.2s ease;
    }
    .mc-btn-outline:hover { background: var(--mc-pale, #D9F5EF); color: var(--mc-deep, #2F5D57); }
    .mc-chat-note {
        margin-top: 0.75rem;
        color: var(--mc-deep, #2F5D57);
        opacity: 0.72;
        font-size: 0.9rem;
    }
</style>

<div class="mc-user-appointments">
    <header class="mc-user-appointments-header"><div><p>YOUR CARE</p><h1>My Appointments</h1><span>View your scheduled sessions and access messaging when it becomes available.</span></div><a asp-controller="Booking" asp-action="Index">Find a Counsellor</a></header>

    @if (!Model.Any())
    {
        <section class="mc-user-appointments-empty">
            <span aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3v4m8-4v4M4 10h16"/></svg></span><h2>No appointments yet</h2><p>When you book a counselling session, your appointments will appear here.</p><a asp-controller="Booking" asp-action="Index">Find a Counsellor</a>
        </section>
    }
    else
    {
        <div class="mc-user-appointment-groups" data-appointment-accordion data-highlight-appointment-id="@highlightAppointmentId" data-chat-server-now="@serverNow.ToString("O")">
            @foreach (var group in dateGroups)
            {
                var isOpen = group.Key == defaultOpenDate;
                var panelId = $"appointment-date-{group.Key:yyyyMMdd}";
                <section class="mc-user-appointment-date-group">
                    <button type="button" class="mc-user-appointment-date-toggle" aria-expanded="@isOpen.ToString().ToLowerInvariant()" aria-controls="@panelId"><span>@group.Key.ToString("dddd, dd MMMM yyyy")</span><small>@group.Count() appointment@(group.Count() == 1 ? "" : "s")</small><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
                    <div id="@panelId" class="mc-user-appointment-date-panel" hidden="@(!isOpen)">
                    @foreach (var appointment in group.OrderBy(appointment => appointment.StartTime))
                    {
                        var statusClass = appointment.Status switch { AppointmentStatuses.Completed => "mc-user-appointment-status--completed", AppointmentStatuses.Cancelled => "mc-user-appointment-status--cancelled", _ => "mc-user-appointment-status--booked" };
                        var isChatEligible = (appointment.Status == AppointmentStatuses.Booked || appointment.Status == AppointmentStatuses.Confirmed) && (appointment.PaymentStatus == PaymentStatuses.Paid || appointment.PaymentStatus == PaymentStatuses.Confirmed);
                        var chatState = isChatEligible ? ChatWindowService.GetState(appointment) : (MindCare.Services.AppointmentChatWindowState?)null;
                        var chatBoundary = chatState == MindCare.Services.AppointmentChatWindowState.BeforeStart ? appointment.Date.Date.Add(appointment.StartTime) : chatState == MindCare.Services.AppointmentChatWindowState.Open ? appointment.Date.Date.Add(appointment.EndTime) : (DateTime?)null;
                        <article id="appointment-@appointment.Id" class="mc-user-appointment-card @(appointment.Id == highlightAppointmentId ? "mc-user-appointment-card--highlight" : "")" data-chat-transition-at="@(chatBoundary?.ToString("O"))">
                            <div class="mc-user-appointment-time"><span aria-hidden="true">◷</span><strong>@FormatTime(appointment.StartTime) - @FormatTime(appointment.EndTime)</strong></div>
                            <div class="mc-user-appointment-counsellor"><span>Counsellor</span><strong>@appointment.CounsellorProfile.ApplicationUser.Name</strong></div>
                            <div class="mc-user-appointment-right"><span class="mc-user-appointment-status @statusClass">@appointment.Status</span>
                            @if (CanOpenChat(appointment)) { <div class="d-flex flex-wrap gap-2 justify-content-end"><a asp-controller="Messaging" asp-action="Chat" asp-route-appointmentId="@appointment.Id" class="mc-user-appointment-chat">Open Chat</a><a asp-controller="Appointments" asp-action="VideoCall" asp-route-appointmentId="@appointment.Id" class="mc-user-appointment-chat">Join Video Call</a></div> }
                            else if (isChatEligible) { <span class="mc-user-appointment-message">@(chatState == MindCare.Services.AppointmentChatWindowState.Ended ? "Chat and video session ended." : $"Chat and video session available at {FormatTime(appointment.StartTime)}")</span> }</div>
                        </article>
                    }
                    </div>
                </section>
            }
        </div>
    }
</div>

@section Scripts {
<script>
document.querySelectorAll('[data-appointment-accordion] .mc-user-appointment-date-toggle').forEach(function (toggle) {
    toggle.addEventListener('click', function () {
        var panel = document.getElementById(toggle.getAttribute('aria-controls'));
        var willOpen = toggle.getAttribute('aria-expanded') !== 'true';
        document.querySelectorAll('[data-appointment-accordion] .mc-user-appointment-date-toggle').forEach(function (item) { item.setAttribute('aria-expanded', 'false'); document.getElementById(item.getAttribute('aria-controls')).hidden = true; });
        toggle.setAttribute('aria-expanded', String(willOpen)); panel.hidden = !willOpen;
    });
});

var appointmentGroups = document.querySelector('[data-appointment-accordion]');
var highlightId = appointmentGroups && appointmentGroups.dataset.highlightAppointmentId;
if (highlightId) {
    var highlightedAppointment = document.getElementById('appointment-' + highlightId);
    if (highlightedAppointment) {
        window.requestAnimationFrame(function () {
            highlightedAppointment.scrollIntoView({ block: 'center', behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
        });
        window.setTimeout(function () {
            highlightedAppointment.classList.remove('mc-user-appointment-card--highlight');
            highlightedAppointment.querySelector('[data-appointment-highlight-label]')?.remove();
        }, 7000);
        var cleanUrl = new URL(window.location.href);
        cleanUrl.searchParams.delete('highlightAppointmentId');
        window.history.replaceState({}, '', cleanUrl);
    }
}

var serverNowValue = appointmentGroups && appointmentGroups.dataset.chatServerNow;
var nextChatBoundary = Array.from(document.querySelectorAll('[data-chat-transition-at]')).map(function (item) { return item.dataset.chatTransitionAt; }).filter(Boolean).map(function (value) { return new Date(value).getTime(); }).filter(function (value) { return !Number.isNaN(value); }).sort(function (a, b) { return a - b; })[0];
var serverNowTime = serverNowValue ? new Date(serverNowValue).getTime() : NaN;
if (nextChatBoundary && !Number.isNaN(serverNowTime)) {
    var refreshDelay = nextChatBoundary - serverNowTime + 250;
    if (refreshDelay > 0 && refreshDelay < 86400000) window.setTimeout(function () { window.location.reload(); }, refreshDelay);
}
</script>
}
