@model MindCare.ViewModels.DummyPaymentViewModel

@{
    ViewData["Title"] = "Dummy Payment";
    string FormatTime(TimeSpan time) => DateTime.Today.Add(time).ToString("h:mm tt");
    var counsellor = Model.Slot.CounsellorProfile.ApplicationUser;
}

<h1 class="h3 mb-3">Dummy Payment</h1>

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h5">Appointment</h2>
        <p class="mb-1"><strong>Counsellor:</strong> @counsellor.Name</p>
        <p class="mb-1"><strong>Date:</strong> @Model.Slot.Date.ToString("dd MMMM yyyy")</p>
        <p class="mb-0"><strong>Time:</strong> @FormatTime(Model.Slot.StartTime) - @FormatTime(Model.Slot.EndTime)</p>
    </div>
</div>

<form asp-action="ConfirmDummyPayment" method="post">
    <input type="hidden" asp-for="SlotId" />
    <button type="submit" class="btn btn-primary">Dummy Payment / Confirm Payment</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
