@model MindCare.ViewModels.BookAppointmentViewModel

@{
    ViewData["Title"] = "Find and Book Counsellor";
    string FormatTime(TimeSpan time) => DateTime.Today.Add(time).ToString("h:mm tt");
    var selectedCounsellor = Model.Counsellors.FirstOrDefault(counsellor => counsellor.Id == Model.CounsellorProfileId);
}

<style>
    .mc-page { max-width: 900px; margin: 0 auto; }
    .mc-page h1 {
        font-family: var(--mc-font-heading, 'Lora', 'Playfair Display', serif);
        color: var(--mc-deep, #2F5D57);
    }
    .mc-page h2 {
        font-family: var(--mc-font-heading, 'Lora', 'Playfair Display', serif);
        color: var(--mc-deep, #2F5D57);
    }
    .mc-alert-danger {
        background: #FBEAEA;
        border: 1px solid #E7B3B3;
        border-left: 4px solid #C96A6A;
        color: #7A3535;
        border-radius: 12px;
        padding: 0.9rem 1.1rem;
        margin-bottom: 1.25rem;
    }
    .mc-filter-card {
        background: #fff;
        border: 1px solid var(--mc-pale, #D9F5EF);
        border-radius: 18px;
        padding: 1.5rem;
        box-shadow: 0 8px 24px rgba(47, 93, 87, 0.06);
        margin-bottom: 1.5rem;
    }
    .mc-filter-card .form-label {
        color: var(--mc-deep, #2F5D57);
        font-weight: 600;
        font-size: 0.92rem;
    }
    .mc-filter-card .form-select,
    .mc-filter-card .form-control {
        border: 1px solid var(--mc-pale, #D9F5EF);
        border-radius: 12px;
        padding: 0.6rem 0.9rem;
        background: var(--mc-mist, #F7FFFD);
    }
    .mc-filter-card .form-select:focus,
    .mc-filter-card .form-control:focus {
        border-color: var(--mc-teal, #5BB9A6);
        box-shadow: 0 0 0 0.2rem rgba(91, 185, 166, 0.25);
        background: #fff;
    }
    .mc-btn-primary {
        background: var(--mc-teal, #5BB9A6);
        border: none;
        color: #fff;
        border-radius: 999px;
        padding: 0.6rem 1rem;
        font-weight: 600;
        transition: background 0.2s ease, transform 0.2s ease;
    }
    .mc-btn-primary:hover { background: var(--mc-deep, #2F5D57); color: #fff; transform: translateY(-1px); }
    .mc-btn-outline {
        border: 1px solid var(--mc-deep, #2F5D57);
        color: var(--mc-deep, #2F5D57);
        background: transparent;
        border-radius: 999px;
        padding: 0.6rem 1.3rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        transition: background 0.2s ease, color 0.2s ease;
    }
    .mc-btn-outline:hover { background: var(--mc-pale, #D9F5EF); color: var(--mc-deep, #2F5D57); }
    .mc-btn-slot {
        border: 1px solid var(--mc-teal, #5BB9A6);
        color: var(--mc-teal, #5BB9A6);
        background: transparent;
        border-radius: 999px;
        padding: 0.4rem 1rem;
        font-weight: 600;
        font-size: 0.9rem;
        transition: background 0.2s ease, color 0.2s ease;
    }
    .mc-btn-slot:hover { background: var(--mc-teal, #5BB9A6); color: #fff; }
    .mc-slots-list {
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
        margin-bottom: 1.5rem;
    }
    .mc-slot-row {
        background: #fff;
        border: 1px solid var(--mc-pale, #D9F5EF);
        border-radius: 14px;
        padding: 0.85rem 1.15rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.6rem;
        transition: box-shadow 0.2s ease, transform 0.2s ease;
    }
    .mc-slot-row:hover {
        box-shadow: 0 6px 18px rgba(47, 93, 87, 0.08);
        transform: translateY(-1px);
    }
    .mc-slot-time {
        color: var(--mc-deep, #2F5D57);
        font-weight: 600;
    }
    .mc-empty-state {
        background: var(--mc-pale, #D9F5EF);
        border-radius: 16px;
        padding: 1.5rem;
        text-align: center;
        color: var(--mc-deep, #2F5D57);
        margin-bottom: 1.5rem;
    }
</style>

<div class="mc-booking-page">
    <header class="mc-booking-header"><p class="mc-booking-eyebrow">Your care</p><h1>Find and Book Counsellor</h1><p>Choose a counsellor and a date to view available appointment times.</p></header>

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="mc-booking-alert">@errorMessage</div>
    }

    <section class="mc-booking-search-card" aria-labelledby="booking-step-one-title">
        <header><span class="mc-booking-step-badge">Step 1</span><div><h2 id="booking-step-one-title">Choose counsellor and date</h2><p>Select who you would like to meet and the date that works for you.</p></div></header>
        <form asp-action="Index" method="get" class="mc-booking-form-grid">
            <div class="mc-booking-field">
                <label for="counsellorProfileId" class="form-label">Select Counsellor</label>
                <select id="counsellorProfileId" name="counsellorProfileId" class="form-select" required>
                    <option value="">Choose a counsellor</option>
                    @foreach (var counsellor in Model.Counsellors)
                    {
                        if (Model.CounsellorProfileId == counsellor.Id)
                        {
                            <option value="@counsellor.Id" selected>@counsellor.ApplicationUser.Name - @counsellor.Specialization</option>
                        }
                        else
                        {
                            <option value="@counsellor.Id">@counsellor.ApplicationUser.Name - @counsellor.Specialization</option>
                        }
                    }
                </select>
            </div>

            <div class="mc-booking-field">
                <label for="date" class="form-label">Select Date</label>
                <input id="date" name="date" value="@Model.Date?.ToString("yyyy-MM-dd")" class="form-control" type="date" required />
            </div>

            <div class="mc-booking-field mc-booking-field-action">
                <button type="submit" class="mc-booking-view-slots">View Available Slots</button>
            </div>
        </form>
    </section>

    <section class="mc-booking-slots-section" aria-labelledby="booking-step-two-title">
        <header class="mc-booking-slots-header"><span class="mc-booking-step-badge">Step 2</span><div><h2 id="booking-step-two-title">Available Slots</h2>
        @if (selectedCounsellor is not null && Model.Date.HasValue) { <p>Available times for @selectedCounsellor.ApplicationUser.Name on @Model.Date.Value.ToString("dddd, dd MMMM yyyy").</p> } else { <p>Choose a counsellor and date to view appointment times.</p> }</div></header>

        @if (Model.CounsellorProfileId is null || Model.Date is null)
        {
            <div class="mc-booking-empty">
                <span aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3v4m8-4v4M4 10h16m-5 4v3m-1.5-1.5h3"/></svg></span><h3>Choose a counsellor and date</h3><p>Available appointment times will appear here.</p>
            </div>
        }
        else if (!Model.AvailableSlots.Any())
        {
            <div class="mc-booking-empty mc-booking-empty--no-slots">
                <span aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l2.5 1.5"/></svg></span><h3>No available slots for this date</h3><p>Try another date or choose a different counsellor.</p>
            </div>
        }
        else
        {
            <div class="mc-booking-slots-grid">
                @foreach (var slot in Model.AvailableSlots)
                {
                    <form asp-action="SelectSlot" method="post" class="mc-booking-slot">
                        <div><span class="mc-booking-slot-status">Available</span><strong>@FormatTime(slot.StartTime) - @FormatTime(slot.EndTime)</strong></div>
                        <input type="hidden" name="slotId" value="@slot.Id" />
                        <button type="submit" class="mc-booking-slot-action">Continue to Payment</button>
                    </form>
                }
            </div>
        }
    </section>

</div>
