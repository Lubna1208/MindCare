@model MindCare.Models.Appointment

@{
    ViewData["Title"] = "Booking Confirmed";
    string FormatTime(TimeSpan time) => DateTime.Today.Add(time).ToString("h:mm tt");
    var counsellor = Model.CounsellorProfile.ApplicationUser;
    var counsellorInitial = string.IsNullOrWhiteSpace(counsellor.Name) ? "C" : counsellor.Name.Trim()[0].ToString().ToUpperInvariant();
    var isBdtPayment = string.Equals(Model.Currency, "bdt", StringComparison.OrdinalIgnoreCase);
    var amountDisplay = Model.AmountPaidCents.HasValue
        ? (Model.AmountPaidCents.Value / 100m).ToString(isBdtPayment ? "0" : "0.00")
        : null;
}

<section class="mc-booking-confirmed" aria-labelledby="booking-confirmed-title">
    <header class="mc-booking-confirmed-hero">
        <span class="mc-booking-success-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12 4.2 4.2L19 6.8"/></svg></span>
        <div><p>Booking confirmed</p><h1 id="booking-confirmed-title">Your appointment is booked</h1><span>Your payment was successful and your session has been scheduled.</span></div>
    </header>

    <div class="mc-booking-success-banner" role="status" data-auto-dismiss="5000">
        <span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12 4.2 4.2L19 6.8"/></svg></span>
        <p>Your payment was successful and the appointment has been booked.</p>
    </div>

    <article class="mc-booking-receipt" aria-labelledby="appointment-details-title">
        <div class="mc-booking-receipt-heading"><p id="appointment-details-title">Appointment details</p><div class="mc-booking-counsellor"><span aria-hidden="true">@counsellorInitial</span><strong>@counsellor.Name</strong></div></div>
        <div class="mc-booking-detail-grid">
            <div><span>Date</span><strong>@Model.Date.ToString("dd MMMM yyyy")</strong></div>
            <div><span>Time</span><strong>@FormatTime(Model.StartTime) – @FormatTime(Model.EndTime)</strong></div>
            <div><span>Status</span><strong><i class="mc-booking-status">@Model.Status</i></strong></div>
            <div><span>Payment</span><strong><i class="mc-booking-payment">@Model.PaymentStatus</i></strong></div>
        </div>
        @if (amountDisplay is not null)
        {
            <div class="mc-booking-amount"><span>Amount paid</span><strong>@(isBdtPayment ? $"৳{amountDisplay}" : $"{Model.Currency?.ToUpperInvariant()} {amountDisplay}") @if (isBdtPayment) { <small>BDT</small> }</strong></div>
        }
    </article>

    <p class="mc-booking-confirmed-note">You can review this appointment anytime from My Appointments. Messaging will be available when your appointment starts.</p>
    <div class="mc-booking-confirmed-actions"><a asp-action="MyAppointments" asp-route-highlightAppointmentId="@Model.Id">My Appointments <span aria-hidden="true">→</span></a></div>
</section>
