@model MindCare.ViewModels.ResourceEditViewModel
@if (ViewData["CounsellorResourceFormDesign"] as string == "add")
{
    <form method="post" class="mc-resource-form mc-resource-form-card">
        <div asp-validation-summary="ModelOnly" class="mc-resource-form-validation" role="alert"></div>
        <section class="mc-resource-form-section" aria-labelledby="counsellorBasicInformationTitle"><header><p>BASIC INFORMATION</p><h2 id="counsellorBasicInformationTitle">Resource details</h2></header><div class="mc-resource-form-field"><label asp-for="Title"></label><span class="mc-resource-form-help">Use a clear and concise title.</span><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="mc-resource-form-error"></span></div><div class="mc-resource-form-field"><label asp-for="Description">Short description</label><span class="mc-resource-form-help">Give users a quick overview of what this resource covers.</span><textarea asp-for="Description" class="form-control" rows="4"></textarea><span asp-validation-for="Description" class="mc-resource-form-error"></span></div><div class="mc-resource-form-field"><label asp-for="CategoryId">Category</label><span class="mc-resource-form-help">Choose the category that best matches this resource.</span><select asp-for="CategoryId" class="form-select"><option value="">Choose a category</option>@foreach (var category in Model.Categories) { <option value="@category.Id">@category.Name</option> }</select><span asp-validation-for="CategoryId" class="mc-resource-form-error"></span></div></section>
        <section class="mc-resource-form-section" aria-labelledby="counsellorContentTitle"><header><p>RESOURCE CONTENT</p><h2 id="counsellorContentTitle">Write the resource</h2></header><div class="mc-resource-form-field"><label asp-for="Content"></label><span class="mc-resource-form-help">Write the full resource content that you would like Admin to review.</span><textarea asp-for="Content" class="form-control mc-resource-form-content" rows="14"></textarea><span asp-validation-for="Content" class="mc-resource-form-error"></span></div></section>
        <section class="mc-resource-form-section" aria-labelledby="counsellorSourceTitle"><header><p>SOURCE</p><h2 id="counsellorSourceTitle">Reference details</h2></header><div class="mc-resource-form-field"><label asp-for="Url">Source URL <small>Optional</small></label><span class="mc-resource-form-help">Add a reliable reference or external source if applicable.</span><input asp-for="Url" class="form-control" /><span asp-validation-for="Url" class="mc-resource-form-error"></span></div></section>
        <footer class="mc-resource-form-actions"><a asp-action="Index" class="mc-resource-form-cancel">Cancel</a><div><button name="command" value="draft" class="mc-resource-form-draft">Save as Draft</button><button name="command" value="submit" class="mc-resource-form-publish">Submit for Review</button></div></footer>
    </form>
}
else
{
    <form method="post" class="mc-resource-form"><div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="Title"></label><input asp-for="Title" class="form-control"/><span asp-validation-for="Title" class="text-danger"></span><label asp-for="Description">Short description</label><textarea asp-for="Description" class="form-control" rows="3"></textarea><span asp-validation-for="Description" class="text-danger"></span><label asp-for="CategoryId">Category</label><select asp-for="CategoryId" class="form-select"><option value="">Choose a category</option>@foreach(var c in Model.Categories){<option value="@c.Id">@c.Name</option>}</select><span asp-validation-for="CategoryId" class="text-danger"></span><label asp-for="Content"></label><textarea asp-for="Content" class="form-control" rows="12"></textarea><span asp-validation-for="Content" class="text-danger"></span><label asp-for="Url">Optional source URL</label><input asp-for="Url" class="form-control"/><div class="mt-4"><button name="command" value="draft" class="btn btn-outline-secondary">Save as Draft</button><button name="command" value="submit" class="btn mc-btn-primary">Submit for Review</button><a asp-action="Index" class="btn btn-link">Cancel</a></div></form>
}
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
