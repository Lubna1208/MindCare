@model IEnumerable<MindCare.Models.Resource>
@using MindCare.Models
@{
    ViewData["Title"] = "My Resources";
    var draftCount = Model.Count(resource => resource.Status == ResourceStatus.Draft);
    var pendingCount = Model.Count(resource => resource.Status == ResourceStatus.PendingReview);
    var publishedCount = Model.Count(resource => resource.Status == ResourceStatus.Published);
    var rejectedCount = Model.Count(resource => resource.Status == ResourceStatus.Rejected);
}
<section class="mc-counsellor-resources"><div class="mc-counsellor-resources-container">
    <header class="mc-counsellor-resources-header"><div><p>MY CONTRIBUTIONS</p><h1>My Resources</h1><span>Create helpful wellbeing resources and submit them for Admin review.</span></div><nav class="mc-counsellor-resources-actions" aria-label="Resource actions"><a asp-action="Create" class="mc-counsellor-resource-primary"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>Add Resource</a><a asp-controller="Resources" asp-action="Index" class="mc-counsellor-resource-secondary">Resource Library</a></nav></header>
    <section class="mc-resource-metrics" aria-label="My resource summary"><div class="mc-resource-metric mc-resource-metric--draft"><span>Draft</span><strong>@draftCount</strong></div><div class="mc-resource-metric mc-resource-metric--pending"><span>Pending Review</span><strong>@pendingCount</strong></div><div class="mc-resource-metric mc-resource-metric--published"><span>Published</span><strong>@publishedCount</strong></div><div class="mc-resource-metric mc-resource-metric--rejected"><span>Rejected</span><strong>@rejectedCount</strong></div></section>
    <section class="mc-resource-contributions" aria-labelledby="contributionsTitle"><header><div><h2 id="contributionsTitle">My Contributions</h2><p>Track your drafts, submissions, published resources, and review feedback.</p></div><span>@Model.Count() resource@(Model.Count() == 1 ? "" : "s")</span></header>
        @if (!Model.Any()) { <div class="mc-counsellor-resource-empty"><span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 3.5h8l4 4V20a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4.5a1 1 0 0 1 1-1Z"/><path d="M14 3.5v4h4M8.5 12h7m-7 3.5h7"/></svg></span><h3>You haven't created any resources yet.</h3><p>Create your first resource and submit it for Admin review when you're ready.</p><div><a asp-action="Create" class="mc-counsellor-resource-primary">Create Your First Resource</a><a asp-controller="Resources" asp-action="Index" class="mc-counsellor-resource-secondary">Browse Resource Library</a></div></div> }
        else { <div class="mc-counsellor-resource-grid">@foreach (var resource in Model) { var statusClass = resource.Status switch { ResourceStatus.Draft => "draft", ResourceStatus.PendingReview => "pending", ResourceStatus.Published => "published", ResourceStatus.Rejected => "rejected", _ => "archived" }; var statusText = resource.Status == ResourceStatus.PendingReview ? "Pending Review" : resource.Status.ToString(); <article class="mc-counsellor-resource-card"><header><span class="mc-counsellor-resource-status mc-counsellor-resource-status--@statusClass">@statusText</span><span class="mc-counsellor-resource-category">@(resource.ResourceCategory?.Name ?? resource.Category)</span></header><h3>@resource.Title</h3><p class="mc-counsellor-resource-date">Updated @resource.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy")@if (resource.SubmittedAt.HasValue) { <span>· Submitted @resource.SubmittedAt.Value.ToLocalTime().ToString("dd MMM yyyy")</span> }</p>@if (resource.Status == ResourceStatus.Rejected) { <div class="mc-counsellor-resource-feedback"><strong>Review feedback</strong><p>@resource.ReviewNote</p></div> }@if (resource.Status == ResourceStatus.PendingReview) { <p class="mc-counsellor-resource-waiting">Waiting for Admin review</p> }<footer>@if (resource.Status is ResourceStatus.Draft or ResourceStatus.Rejected) { <a asp-action="Edit" asp-route-id="@resource.Id" class="mc-counsellor-resource-action">Edit</a><form asp-action="Submit" asp-route-id="@resource.Id" method="post">@Html.AntiForgeryToken()<button class="mc-counsellor-resource-action mc-counsellor-resource-action--submit">Submit for Review</button></form><form asp-action="Archive" asp-route-id="@resource.Id" method="post" onsubmit="return confirm('Archive this resource?');">@Html.AntiForgeryToken()<button class="mc-counsellor-resource-action mc-counsellor-resource-action--archive">Archive</button></form> } else if (resource.Status == ResourceStatus.Published) { <a asp-controller="Resources" asp-action="Details" asp-route-id="@resource.Id" class="mc-counsellor-resource-action mc-counsellor-resource-action--submit">View Resource</a> }</footer></article> }</div> }
    </section>
</div></section>
