@model IEnumerable<MindCare.Models.Resource>
@using MindCare.Models
@{ ViewData["Title"] = "My Resources"; }
<section class="mc-resources-page"><div class="mc-resources-container"><header class="mc-resources-hero"><p class="mc-eyebrow">MY CONTRIBUTIONS</p><h1>Resources</h1><p>Create helpful resources and submit them for Admin review.</p><a asp-action="Create" class="btn mc-btn-primary">+ Add Resource</a> <a asp-controller="Resources" asp-action="Index" class="btn btn-outline-secondary">Resource Library</a></header>
<div class="mc-resource-summary-row"><span>Draft: @Model.Count(r=>r.Status==ResourceStatus.Draft)</span><span>Pending Review: @Model.Count(r=>r.Status==ResourceStatus.PendingReview)</span><span>Published: @Model.Count(r=>r.Status==ResourceStatus.Published)</span><span>Rejected: @Model.Count(r=>r.Status==ResourceStatus.Rejected)</span></div>
@if(!Model.Any()){<div class="mc-resources-empty"><h2>You haven't created any resources yet.</h2><a asp-action="Create">Create your first resource</a></div>}else{<div class="mc-resources-grid">@foreach(var r in Model){<article class="mc-resource-card"><span class="mc-resource-badge">@r.Status</span><h2>@r.Title</h2><p>@(r.ResourceCategory?.Name??r.Category)</p><small>Updated @r.UpdatedAt.ToLocalTime().ToString("d")</small>@if(r.Status==ResourceStatus.Rejected){<p class="mc-resource-feedback"><strong>Review feedback:</strong> @r.ReviewNote</p>}<div class="mt-3">@if(r.Status is ResourceStatus.Draft or ResourceStatus.Rejected){<a asp-action="Edit" asp-route-id="@r.Id" class="mc-resource-action">Edit</a><form asp-action="Submit" asp-route-id="@r.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button class="btn btn-link">Submit for review</button></form><form asp-action="Archive" asp-route-id="@r.Id" method="post" class="d-inline" onsubmit="return confirm('Archive this resource?');">@Html.AntiForgeryToken()<button class="btn btn-link">Archive</button></form>}else if(r.Status==ResourceStatus.Published){<a asp-controller="Resources" asp-action="Details" asp-route-id="@r.Id">View published resource</a>}else{<span>Under Admin review</span>}</div></article>}</div>}</div></section>
