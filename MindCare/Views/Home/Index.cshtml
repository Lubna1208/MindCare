@{
    ViewData["Title"] = "Welcome";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}

<div class="mc-home-page">
    <section class="mc-home-hero-section" aria-labelledby="home-title">
        <div class="mc-home-container">
            <div class="mc-home-hero">
                <div class="mc-home-hero-content">
                    <p class="mc-home-eyebrow">A gentler way forward</p>
                    <h1 id="home-title" class="mc-home-title">Caring for your mind, one day at a time.</h1>
                    <p class="mc-home-copy">MindCare gives you a calm space to notice how you feel, reflect on your wellbeing, and find supportive resources whenever you need them.</p>

                    <div class="mc-home-actions">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Dashboard" asp-action="Index" class="btn mc-home-primary">Go to Dashboard</a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Register" class="btn mc-home-primary">Get Started</a>
                            <a asp-controller="Account" asp-action="Login" class="btn mc-home-secondary">Login</a>
                        }
                    </div>

                    <a asp-controller="Support" asp-action="Immediate" class="mc-home-help-callout">
                        <span>Need immediate help?</span> Talk to someone now <span aria-hidden="true">&rarr;</span>
                    </a>
                </div>

                <div class="mc-home-art-wrap">
                    <img src="~/images/mindcare-brain-flowers.png" class="mc-home-art" alt="Illustration of a mind blooming with flowers, representing mental wellbeing" />
                </div>
            </div>
        </div>
    </section>

    <section class="mc-home-features-section" aria-labelledby="wellbeing-tools-title">
        <div class="mc-home-container">
            <header class="mc-home-section-heading">
                <h2 id="wellbeing-tools-title">Support for your everyday wellbeing</h2>
                <p>Simple tools to help you reflect, understand and take care of yourself.</p>
            </header>

            <div class="mc-home-feature-grid">
                @if (isAuthenticated)
                {
                    <article class="mc-home-feature mc-feature-card--interactive"><a asp-controller="Mood" asp-action="Index" class="mc-home-feature-link"><span class="mc-home-feature-icon" aria-hidden="true">😊</span><h3>Mood Tracking</h3><p>Pause for a simple daily check-in and notice patterns over time.</p><span class="mc-home-feature-action">Check in <span aria-hidden="true">&rarr;</span></span></a></article>
                    <article class="mc-home-feature mc-feature-card--interactive"><a asp-controller="Assessment" asp-action="Index" class="mc-home-feature-link"><span class="mc-home-feature-icon" aria-hidden="true">🧘</span><h3>Wellbeing Assessment</h3><p>Take a thoughtful moment to reflect on how you have been feeling.</p><span class="mc-home-feature-action">Start assessment <span aria-hidden="true">&rarr;</span></span></a></article>
                    <article class="mc-home-feature mc-feature-card--interactive"><a asp-controller="Resources" asp-action="Index" class="mc-home-feature-link"><span class="mc-home-feature-icon" aria-hidden="true">🌿</span><h3>Helpful Resources</h3><p>Explore practical guidance and support at a pace that feels right.</p><span class="mc-home-feature-action">Explore resources <span aria-hidden="true">&rarr;</span></span></a></article>
                }
                else
                {
                    <article class="mc-home-feature mc-feature-card--preview"><div class="mc-home-feature-preview"><span class="mc-home-feature-icon" aria-hidden="true">😊</span><h3>Mood Tracking</h3><p>Pause for a simple daily check-in and notice patterns over time.</p><span class="mc-feature-access-status"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>Available after login</span></div></article>
                    <article class="mc-home-feature mc-feature-card--preview"><div class="mc-home-feature-preview"><span class="mc-home-feature-icon" aria-hidden="true">🧘</span><h3>Wellbeing Assessment</h3><p>Take a thoughtful moment to reflect on how you have been feeling.</p><span class="mc-feature-access-status"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>Available after login</span></div></article>
                    <article class="mc-home-feature mc-feature-card--preview"><div class="mc-home-feature-preview"><span class="mc-home-feature-icon" aria-hidden="true">🌿</span><h3>Helpful Resources</h3><p>Explore practical guidance and support at a pace that feels right.</p><span class="mc-feature-access-status"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>Available after login</span></div></article>
                }
            </div>
        </div>
    </section>

    <section class="mc-home-trust-section" aria-label="MindCare values">
        <div class="mc-home-container">
            <div class="mc-home-trust-grid">
                <article class="mc-home-trust-item">
                    <span class="mc-home-trust-icon" aria-hidden="true">&#10003;</span>
                    <div>
                        <h2>Private &amp; secure</h2>
                        <p>Your wellbeing information is handled with care.</p>
                    </div>
                </article>
                <article class="mc-home-trust-item">
                    <span class="mc-home-trust-icon" aria-hidden="true">&#9825;</span>
                    <div>
                        <h2>Supportive space</h2>
                        <p>A calm environment designed around mental wellbeing.</p>
                    </div>
                </article>
                <article class="mc-home-trust-item">
                    <span class="mc-home-trust-icon" aria-hidden="true">&#9719;</span>
                    <div>
                        <h2>Accessible anytime</h2>
                        <p>Helpful tools and resources whenever you need them.</p>
                    </div>
                </article>
            </div>
        </div>
    </section>
</div>
