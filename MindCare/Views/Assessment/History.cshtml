@model IEnumerable<MindCare.ViewModels.AssessmentResultViewModel>

@{
    ViewData["Title"] = "Assessment History";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Assessment History</h1>
    <a asp-action="Index" class="btn btn-primary">Take Assessment</a>
</div>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Score</th>
                    <th>Wellbeing indication</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var assessment in Model)
                {
                    <tr>
                        <td>@assessment.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@assessment.Score of @AssessmentQuestionnaire.MaximumScore</td>
                        <td>@assessment.RiskLevel</td>
                        <td><a asp-action="Result" asp-route-id="@assessment.Id">View result</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <p class="text-muted">You have not completed an assessment yet.</p>
}
