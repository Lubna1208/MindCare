@model IEnumerable<MindCare.ViewModels.AssessmentResultViewModel>

@{
    ViewData["Title"] = "Assessment History";
}

<section class="mc-assessment-history-page" aria-labelledby="assessment-history-title">
    <header class="mc-assessment-history-hero">
        <div>
            <p class="mc-assessment-history-eyebrow">Your wellbeing journey</p>
            <h1 id="assessment-history-title">Assessment History</h1>
            <p>Review your previous wellbeing check-ins and see how things have changed over time.</p>
        </div>
        <a asp-action="Index" class="mc-assessment-history-take">Take Assessment</a>
    </header>

    @if (Model.Any())
    {
        <section class="mc-assessment-history-section" aria-label="Previous assessment results">
            <div class="mc-assessment-history-section-heading">
                <div>
                    <h2>Your previous results</h2>
                    <p>Each result is a wellbeing indication, not a diagnosis.</p>
                </div>
                <span class="mc-assessment-history-count">@Model.Count() check-in@(Model.Count() == 1 ? "" : "s")</span>
            </div>

            <div class="mc-assessment-history-table-wrap">
                <table class="mc-assessment-history-table">
                    <thead>
                        <tr>
                            <th scope="col">Date</th>
                            <th scope="col">Score</th>
                            <th scope="col">Wellbeing indication</th>
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var assessment in Model)
                        {
                            var riskTone = assessment.RiskLevel switch
                            {
                                "Low" => "low",
                                "Moderate" => "moderate",
                                "High" => "high",
                                _ => "moderate"
                            };
                            <tr>
                                <td data-label="Date">@assessment.CreatedAt.ToLocalTime().ToString("dd MMM yyyy · hh:mm tt")</td>
                                <td data-label="Score"><strong>@assessment.Score</strong><span> of @AssessmentQuestionnaire.MaximumScore</span></td>
                                <td data-label="Wellbeing indication">
                                    <span class="mc-assessment-history-indication mc-assessment-history-indication--@riskTone"><span aria-hidden="true"></span>@assessment.RiskLevel</span>
                                </td>
                                <td class="mc-assessment-history-action-cell"><a asp-action="Result" asp-route-id="@assessment.Id" class="mc-assessment-history-view">View result <span aria-hidden="true">→</span></a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
    else
    {
        <section class="mc-assessment-history-empty" aria-label="No assessments yet">
            <span class="mc-assessment-history-empty-icon" aria-hidden="true">✦</span>
            <h2>Your first check-in starts here</h2>
            <p>You have not completed an assessment yet. It only takes a few calm moments.</p>
            <a asp-action="Index" class="mc-assessment-history-take">Take Assessment</a>
        </section>
    }
</section>
