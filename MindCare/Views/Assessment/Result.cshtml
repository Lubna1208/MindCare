@model MindCare.ViewModels.AssessmentResultViewModel

@{
    ViewData["Title"] = "Assessment Result";
}

<div class="row justify-content-center mc-assessment-result-page">
    <div class="col-md-8 col-lg-7">
        <div class="mc-result-heading mb-3">
            <p class="mc-eyebrow mb-1">Your wellbeing check-in</p>
            <h1 class="mc-page-title mb-0">Assessment Result</h1>
        </div>
        <div class="card mb-3 mc-assessment-result-card">
            <div class="card-body mc-assessment-result-body">
                <div class="mc-result-summary">
                    <div class="mc-result-score">
                        <span class="mc-result-label">Score</span>
                        <p class="mb-0"><strong>@Model.Score</strong><span>of @AssessmentQuestionnaire.MaximumScore</span></p>
                    </div>
                    <div class="mc-result-indication">
                        <span class="mc-result-label">Wellbeing indication</span>
                        <p class="mb-0"><span>@Model.RiskLevel</span></p>
                    </div>
                </div>
                <div class="mc-result-recommendation">
                    <h2 class="h5">Recommendation</h2>
                    <p class="mb-0">@Model.Recommendation</p>
                </div>
            </div>
        </div>

        @if (Model.IsHighRisk)
        {
            <div class="alert alert-warning mc-high-risk-alert" role="alert">
                <span class="mc-high-risk-icon" aria-hidden="true">♥</span>
                This result is a screening indication, not a diagnosis. Additional support may be helpful.
            </div>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <a asp-controller="Support" asp-action="Immediate" class="btn btn-warning">Get Immediate Support</a>
                <a asp-controller="Booking" asp-action="Index" class="btn btn-outline-primary">Talk to a Counsellor</a>
            </div>
        }
        else if (Model.RiskLevel == "Moderate")
        {
            <div class="alert alert-info" role="alert">Your responses indicate that additional support may be helpful. Consider speaking with a mental-health professional.</div>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <a asp-controller="Booking" asp-action="Index" class="btn btn-outline-primary">Talk to a Counsellor</a>
                <a asp-controller="Resources" asp-action="Index" class="btn btn-outline-secondary">View Support Resources</a>
            </div>
        }

        <p class="text-muted mc-assessment-disclaimer-note">This assessment cannot diagnose a mental health condition. If you have concerns about your wellbeing, consider speaking with a qualified professional.</p>

        <div class="mc-result-actions">
            <a asp-action="History" class="btn btn-primary mc-result-history-button">View Assessment History</a>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary mc-result-dashboard-button">Back to Dashboard</a>
        </div>
    </div>
</div>
