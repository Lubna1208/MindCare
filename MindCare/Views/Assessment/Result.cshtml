@model MindCare.ViewModels.AssessmentResultViewModel

@{
    ViewData["Title"] = "Assessment Result";
    var resultTone = Model.RiskLevel switch
    {
        "High" => "high",
        "Moderate" => "moderate",
        _ => "low"
    };
}

<section class="mc-result-page" aria-labelledby="assessment-result-title">
    <header class="mc-result-hero">
        <span class="mc-result-hero-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 20s-6.5-3.7-6.5-9a3.5 3.5 0 0 1 6.1-2.3l.4.6.4-.6a3.5 3.5 0 0 1 6.1 2.3c0 5.3-6.5 9-6.5 9Z"/><path d="M9.5 13c.7.65 1.55 1 2.5 1s1.8-.35 2.5-1"/></svg></span>
        <div><p>Your wellbeing check-in</p><h1 id="assessment-result-title">Assessment Result</h1></div>
    </header>

    <article class="mc-result-card mc-result-card--@resultTone">
        <span class="mc-result-summary-label">Result summary</span>
        <div class="mc-result-summary">
            <section class="mc-result-score" aria-label="Your score">
                <span class="mc-result-label">Score</span>
                <div class="mc-result-score-ring" style="--mc-score-progress: @(Model.Score * 100.0 / AssessmentQuestionnaire.MaximumScore)%"><div><strong>@Model.Score</strong><span>of @AssessmentQuestionnaire.MaximumScore</span></div></div>
            </section>
            <section class="mc-result-indication" aria-label="Wellbeing indication">
                <span class="mc-result-label">Wellbeing indication</span>
                <span class="mc-result-indication-heading">Current indication</span>
                <span class="mc-result-indication-badge mc-result-indication--@resultTone"><i aria-hidden="true"></i>@Model.RiskLevel</span>
            </section>
        </div>

        <section class="mc-result-recommendation" aria-labelledby="recommendation-title">
            <span class="mc-result-recommendation-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 20s-6.5-3.7-6.5-9a3.5 3.5 0 0 1 6.1-2.3l.4.6.4-.6a3.5 3.5 0 0 1 6.1 2.3c0 5.3-6.5 9-6.5 9Z"/><path d="M9.5 13c.7.65 1.55 1 2.5 1s1.8-.35 2.5-1"/></svg></span>
            <div><h2 id="recommendation-title">Recommendation</h2><p>@Model.Recommendation</p></div>
        </section>
    </article>

    @if (Model.IsHighRisk)
    {
        <section class="mc-result-support mc-result-support--high" aria-label="Additional support">
            <div><p>Additional support</p><span>This result is a screening indication, not a diagnosis. Additional support may be helpful.</span></div>
            <nav aria-label="Support actions"><a asp-controller="Support" asp-action="Immediate" class="btn mc-result-support-primary">Get Immediate Support</a><a asp-controller="Booking" asp-action="Index" class="btn mc-result-support-secondary">Talk to a Counsellor</a></nav>
        </section>
    }
    else if (Model.RiskLevel == "Moderate")
    {
        <section class="mc-result-support" aria-label="Additional support">
            <div><p>Additional support</p><span>Your responses indicate that additional support may be helpful. Consider speaking with a mental-health professional.</span></div>
            <nav aria-label="Support actions"><a asp-controller="Booking" asp-action="Index" class="btn mc-result-support-primary">Talk to a Counsellor</a><a asp-controller="Resources" asp-action="Index" class="btn mc-result-support-secondary">View Support Resources</a></nav>
        </section>
    }

    <aside class="mc-result-disclaimer" aria-label="Assessment disclaimer"><span aria-hidden="true">i</span><p>This assessment cannot diagnose a mental health condition. If you have concerns about your wellbeing, consider speaking with a qualified professional.</p></aside>

    <div class="mc-result-actions">
        <p>What would you like to do next?</p>
        <div><a asp-action="History" class="btn mc-result-history-action">View Assessment History</a><a asp-action="Index" class="btn mc-result-retake-action">Retake Assessment</a></div>
    </div>
</section>
