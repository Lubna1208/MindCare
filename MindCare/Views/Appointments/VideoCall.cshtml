@model MindCare.ViewModels.VideoCallViewModel
@using System.Text.Json
@{ ViewData["Title"] = "Video Session"; string FormatTime(TimeSpan time) => DateTime.Today.Add(time).ToString("h:mm tt"); }
<style>
.mc-video-session{width:min(100%,78rem);margin:clamp(1.25rem,3vw,2.25rem) auto 3rem;color:#2f5d57}.mc-video-session-header{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;margin-bottom:1rem}.mc-video-session-eyebrow{margin:0 0 .35rem;color:#3f8378;font-size:.72rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.mc-video-session h1{margin:0;font-family:"Lora",serif;font-size:clamp(1.85rem,3vw,2.4rem)}.mc-video-session-header p:not(.mc-video-session-eyebrow){margin:.45rem 0 0;color:#5d7c76}.mc-video-return{display:inline-flex;min-height:2.6rem;align-items:center;justify-content:center;padding:.5rem .9rem;color:#2f5d57;background:#fff;border:1px solid rgba(47,93,87,.3);border-radius:.6rem;font-weight:800;text-decoration:none}.mc-video-return:hover{color:#245e56;background:#f3fbf9}.mc-video-return:focus-visible{outline:3px solid rgba(91,185,166,.35);outline-offset:3px}.mc-video-session-meta{display:flex;flex-wrap:wrap;gap:.55rem 1rem;padding:.85rem 1rem;margin-bottom:1rem;color:#456e67;background:#f3fbf9;border:1px solid rgba(91,185,166,.2);border-radius:.8rem;font-size:.92rem}.mc-video-session-meta strong{color:#2f5d57}.mc-video-container{position:relative;width:100%;height:clamp(560px,72vh,760px);min-width:0;max-width:100%;overflow:hidden;background:#173f39;border:1px solid rgba(47,93,87,.18);border-radius:16px;box-shadow:0 .65rem 1.75rem rgba(47,93,87,.12)}.mc-video-container iframe{display:block;width:100%;height:100%;border:0}.mc-video-container .mc-video-ended{width:100%;height:100%;min-height:0}.mc-video-status{margin:.8rem 0 0;color:#5d7c76;font-size:.88rem}.mc-video-ended{display:grid;min-height:18rem;place-items:center;padding:2rem;color:#5d7c76;background:#f7fffd;border:1px solid rgba(91,185,166,.2);border-radius:1rem;text-align:center}.mc-video-ended h2{margin:0;color:#2f5d57;font-family:"Lora",serif}.mc-video-ended p{margin:.45rem 0 1rem}@@media(max-width:575.98px){.mc-video-session{max-width:100%;overflow-x:hidden}.mc-video-session-header{flex-direction:column}.mc-video-return{width:100%}.mc-video-container{height:clamp(32rem,72dvh,42rem);border-radius:16px}}
</style>
<section class="mc-video-session" aria-labelledby="videoSessionTitle">
@if (!Model.CanJoin) { <div class="mc-video-ended"><div><h2 id="videoSessionTitle">Video session unavailable</h2><p>@Model.ErrorMessage</p><a class="mc-video-return" asp-controller="@Model.ReturnController" asp-action="@Model.ReturnAction">Return to Appointments</a></div></div> }
else { <header class="mc-video-session-header"><div><p class="mc-video-session-eyebrow">Counselling session</p><h1 id="videoSessionTitle">Video Session</h1><p>Session with <strong>@Model.OtherParticipantDisplayName</strong></p></div><a class="mc-video-return" asp-controller="Messaging" asp-action="Chat" asp-route-appointmentId="@Model.AppointmentId">&larr; Return to Chat</a></header><div class="mc-video-session-meta"><span><strong>@Model.AppointmentDate.ToString("dd MMM yyyy")</strong></span><span>@FormatTime(Model.StartTime) &ndash; @FormatTime(Model.EndTime)</span></div><div id="jitsi-container" class="mc-video-container" aria-label="Video meeting area"></div><p id="video-status" class="mc-video-status" role="status">Session ends at @FormatTime(Model.EndTime).</p> }
</section>
@if (Model.CanJoin) { <script src="https://meet.jit.si/external_api.js"></script><script>(function(){const s=@Html.Raw(JsonSerializer.Serialize(new {domain=Model.Domain,roomName=Model.RoomName,displayName=Model.CurrentParticipantDisplayName,serverNow=Model.ServerNow,endTime=Model.AppointmentEndTime,chatUrl=Url.Action("Chat","Messaging",new {appointmentId=Model.AppointmentId})})),c=document.getElementById('jitsi-container'),status=document.getElementById('video-status');let api,ended=false;const finish=function(){if(ended)return;ended=true;try{api?.executeCommand('hangup');api?.dispose()}catch(_){ }c.innerHTML='<div class="mc-video-ended"><div><h2>Counselling session ended</h2><p>This appointment video session is now closed.</p><a class="mc-video-return" href="'+s.chatUrl+'">Return to Chat</a></div></div>';if(status)status.textContent='Session ended.'};if(typeof JitsiMeetExternalAPI!=='function'){if(status)status.textContent='Video service could not be loaded. Please return to chat.';return}api=new JitsiMeetExternalAPI(s.domain,{roomName:s.roomName,parentNode:c,userInfo:{displayName:s.displayName}});api.addEventListener('readyToClose',function(){window.location.assign(s.chatUrl)});window.setTimeout(finish,Math.max(0,new Date(s.endTime).getTime()-new Date(s.serverNow).getTime()));window.addEventListener('beforeunload',function(){try{api?.dispose()}catch(_){}})})();</script> }
