<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MindCare</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MindCare.styles.css" asp-append-version="true" />
</head>
<body class="@(User.Identity?.IsAuthenticated == true && User.IsInRole(RoleNames.User) && !User.IsInRole(RoleNames.Admin) && !User.IsInRole(RoleNames.Counsellor) ? "mc-user-portal-body" : "")">
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var isAdmin = User.IsInRole(RoleNames.Admin);
        var isCounsellor = User.IsInRole(RoleNames.Counsellor);
        var isMandatoryCounsellorSecurityPage = isCounsellor && currentController == "Counsellor" && currentAction == "ChangeInitialPassword";
        var isUser = User.Identity?.IsAuthenticated == true && User.IsInRole(RoleNames.User) && !isAdmin && !isCounsellor;
        var hasUserPortalShell = isUser;
        var counsellorUser = isCounsellor ? await UserManager.GetUserAsync(User) : null;
        var counsellorName = string.IsNullOrWhiteSpace(counsellorUser?.Name) ? "Counsellor" : counsellorUser.Name.Trim();
        var counsellorInitial = string.IsNullOrWhiteSpace(counsellorName) ? "?" : counsellorName.Trim()[0].ToString().ToUpperInvariant();
        var portalUser = isUser ? await UserManager.GetUserAsync(User) : null;
        var portalUserName = string.IsNullOrWhiteSpace(portalUser?.Name) ? "User" : portalUser.Name.Trim();
        var portalUserInitials = string.Concat(portalUserName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])));
        if (string.IsNullOrEmpty(portalUserInitials)) { portalUserInitials = "U"; }
    }
    <header class="@(isAdmin ? "mc-admin-layout-header" : isCounsellor ? "mc-counsellor-layout-header" : "")">
        <nav class="navbar navbar-expand-md navbar-toggleable-md navbar-light mc-navbar @(isAdmin ? "mc-admin-navbar" : "") @(isCounsellor ? "mc-counsellor-navbar" : "") @(isMandatoryCounsellorSecurityPage ? "mc-security-navbar" : "") @(isUser ? "mc-user-navbar" : "") mb-3">
            <div class="container-fluid mc-navbar-shell">
                <a class="navbar-brand mc-brand" asp-area="" asp-controller="Home" asp-action="Index"><img src="~/images/mindcare-navbar-logo.png" alt="MindCare logo" class="mc-brand-mark" />MindCare</a>
                @if (isUser)
                {
                    <button type="button" class="mc-user-mobile-toggle" data-user-sidebar-toggle aria-label="Open user menu" aria-controls="mcUserSidebar" aria-expanded="false">☰</button>
                }
                else if (!isMandatoryCounsellorSecurityPage)
                {
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
                }
                @if (!isAdmin && !isCounsellor)
                {
                <ul class="navbar-nav @(isUser ? "" : "navbar-collapse collapse") mc-primary-nav">
                    <li class="nav-item">
                        <a class="nav-link mc-nav-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index" aria-current="@(currentController == "Home" && currentAction == "Index" ? "page" : null)">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link mc-nav-link @(currentController == "Home" && currentAction == "Privacy" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Privacy" aria-current="@(currentController == "Home" && currentAction == "Privacy" ? "page" : null)">Privacy Policy</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link mc-nav-link mc-nav-support @(currentController == "Support" && currentAction == "Immediate" ? "active" : "")" asp-controller="Support" asp-action="Immediate" aria-current="@(currentController == "Support" && currentAction == "Immediate" ? "page" : null)">Need immediate help?</a>
                    </li>
                </ul>
                }
                    @if (User.Identity?.IsAuthenticated == true && !isUser && !isMandatoryCounsellorSecurityPage)
                    {
                        <ul class="navbar-nav navbar-collapse collapse mc-member-nav @(isCounsellor ? "mc-counsellor-workspace-nav" : "")">
                            <li class="nav-item">
                                @if (isAdmin)
                                {
                                    <a class="nav-link mc-nav-link @(currentController == "Admin" && currentAction == "Index" ? "active" : "")" asp-area="" asp-controller="Admin" asp-action="Index" aria-current="@(currentController == "Admin" && currentAction == "Index" ? "page" : null)">Dashboard</a>
                                }
                                else if (isCounsellor)
                                {
                                    <a class="nav-link mc-nav-link @(currentController == "Counsellor" && currentAction == "Index" ? "active" : "")" asp-area="" asp-controller="Counsellor" asp-action="Index">Dashboard</a>
                                }
                                else
                                {
                                    <a class="nav-link mc-nav-link" asp-area="" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                                }
                            </li>
                            @if (User.IsInRole("User"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link mc-nav-link" asp-controller="Mood" asp-action="Index">Mood Tracking</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link mc-nav-link" asp-controller="Assessment" asp-action="Index">Assessment</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link mc-nav-link" asp-controller="Booking" asp-action="Index">Find/Book Counsellor</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link mc-nav-link" asp-controller="Booking" asp-action="MyAppointments">My Appointments</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link mc-nav-link" asp-controller="Forum" asp-action="Index">Community Forum</a>
                                </li>
                            }
                            @if (isCounsellor && !isMandatoryCounsellorSecurityPage)
                            {
                                <li class="nav-item">
                                    <a class="nav-link mc-nav-link @(currentController == "Counsellor" && currentAction == "Availability" ? "active" : "")" asp-controller="Counsellor" asp-action="Availability">My Availability</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link mc-nav-link @(currentController == "Counsellor" && currentAction == "BookedAppointments" ? "active" : "")" asp-controller="Counsellor" asp-action="BookedAppointments">Appointments</a>
                                </li>
                            }
                            @if (User.IsInRole("User"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link mc-nav-link @(currentController == "Notification" && currentAction == "Index" ? "active" : "")" asp-controller="Notification" asp-action="Index">@await Component.InvokeAsync("NotificationCount")</a>
                                </li>
                            }
                            @if (User.IsInRole("User"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link mc-nav-link" asp-controller="Notification" asp-action="Settings">Notification Settings</a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link mc-nav-link @(currentController == "Resources" && currentAction == "Index" ? "active" : "")" asp-controller="Resources" asp-action="Index" aria-current="@(currentController == "Resources" && currentAction == "Index" ? "page" : null)">Resources</a>
                            </li>
                        </ul>
                    }
                    <ul class="navbar-nav @(isUser ? "" : "navbar-collapse collapse") mc-account-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (isUser)
                            {
                                <li class="nav-item mc-user-notification-nav"><a class="mc-user-notification-button @(currentController == "Notification" ? "active" : "")" asp-controller="Notification" asp-action="Index" aria-label="Notifications" title="Notifications">@await Component.InvokeAsync("NotificationCount", new { iconOnly = true })</a></li>
                                <li class="nav-item mc-user-identity"><a class="mc-user-avatar @((currentController == "Account" && (currentAction == "Profile" || currentAction == "EditProfile")) ? "active" : "")" asp-controller="Account" asp-action="Profile" title="View profile" aria-label="View profile">@portalUserInitials</a></li>
                            }
                            @if (isCounsellor)
                            {
                                <li class="nav-item mc-counsellor-notification-nav">
                                    <a class="mc-counsellor-notification-link @(currentController == "Notification" && currentAction == "Index" ? "active" : "")" asp-controller="Notification" asp-action="Index" aria-label="Notifications" title="Notifications">@await Component.InvokeAsync("NotificationCount", new { iconOnly = true })</a>
                                </li>
                                <li class="nav-item mc-counsellor-identity">
                                    <a class="mc-counsellor-navbar-avatar @(currentController == "Counsellor" && (currentAction == "Profile" || currentAction == "EditProfile") ? "active" : "")" asp-controller="Counsellor" asp-action="Profile" title="@counsellorName" aria-label="View @counsellorName's profile">@counsellorInitial</a>
                                </li>
                            }
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="nav-link btn btn-link mc-nav-link mc-nav-logout @(isAdmin ? "mc-admin-logout" : "") @(isCounsellor ? "mc-counsellor-logout" : "") @(isUser ? "mc-user-logout" : "")">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link mc-nav-link mc-nav-register @(currentController == "Account" && currentAction == "Register" ? "active" : "")" asp-area="" asp-controller="Account" asp-action="Register" aria-current="@(currentController == "Account" && currentAction == "Register" ? "page" : null)">Register</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link mc-nav-link mc-nav-login" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                        }
                    </ul>
            </div>
        </nav>
    </header>
    @if (hasUserPortalShell)
    {
        <div class="mc-user-shell">
            <div class="mc-user-sidebar-overlay" data-user-sidebar-close hidden></div>
            <aside class="mc-user-sidebar" id="mcUserSidebar" aria-label="User portal navigation" data-user-sidebar>
                <div class="mc-user-sidebar-mobile-header"><span>Menu</span><button type="button" data-user-sidebar-close aria-label="Close user menu">×</button></div>
                <nav>
                    <p class="mc-user-sidebar-label">Main</p>
                    <a class="mc-user-sidebar-link @(currentController == "Dashboard" ? "mc-user-sidebar-link--active" : "")" asp-controller="Dashboard" asp-action="Index" aria-current="@(currentController == "Dashboard" ? "page" : null)"><span class="mc-user-sidebar-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V10Z"/><path d="M9 21v-6h6v6"/></svg></span>Dashboard</a>
                    <a class="mc-user-sidebar-link @(currentController == "Mood" ? "mc-user-sidebar-link--active" : "")" asp-controller="Mood" asp-action="Index" aria-current="@(currentController == "Mood" ? "page" : null)"><span class="mc-user-sidebar-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.9-8.6a5.5 5.5 0 0 0-.1-7.8Z"/></svg></span>Mood Tracking</a>
                    <a class="mc-user-sidebar-link @(currentController == "Assessment" ? "mc-user-sidebar-link--active" : "")" asp-controller="Assessment" asp-action="Index" aria-current="@(currentController == "Assessment" ? "page" : null)"><span class="mc-user-sidebar-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4.5h6v3H9zM9 13l1.6 1.6L15 10.2M9 17h6"/></svg></span>Assessment</a>
                    <p class="mc-user-sidebar-label">Your care</p>
                    <a class="mc-user-sidebar-link @(currentController == "Booking" && currentAction != "MyAppointments" ? "mc-user-sidebar-link--active" : "")" asp-controller="Booking" asp-action="Index" aria-current="@(currentController == "Booking" && currentAction != "MyAppointments" ? "page" : null)"><span class="mc-user-sidebar-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="10.5" cy="10" r="4"/><path d="m14 14 5 5M3 21c.7-3.1 3.2-5 6-5"/></svg></span>Find Counsellor</a>
                    <a class="mc-user-sidebar-link @((currentController == "Booking" && currentAction == "MyAppointments") || (currentController == "Messaging" && currentAction == "Chat") ? "mc-user-sidebar-link--active" : "")" asp-controller="Booking" asp-action="MyAppointments" aria-current="@((currentController == "Booking" && currentAction == "MyAppointments") || (currentController == "Messaging" && currentAction == "Chat") ? "page" : null)"><span class="mc-user-sidebar-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3v4m8-4v4M4 10h16m-11 4h2m2 0h2"/></svg></span>Appointments</a>
                    <p class="mc-user-sidebar-label">Explore</p>
                    <a class="mc-user-sidebar-link @(currentController == "Forum" ? "mc-user-sidebar-link--active" : "")" asp-controller="Forum" asp-action="Index" aria-current="@(currentController == "Forum" ? "page" : null)"><span class="mc-user-sidebar-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20 15a4 4 0 0 1-4 4H9l-5 3v-7a4 4 0 0 1-2-3.5V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4v8Z"/><path d="M7 10h.01M12 10h.01M17 10h.01"/></svg></span>Community</a>
                    <a class="mc-user-sidebar-link @(currentController == "Resources" ? "mc-user-sidebar-link--active" : "")" asp-controller="Resources" asp-action="Index" aria-current="@(currentController == "Resources" ? "page" : null)"><span class="mc-user-sidebar-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H6.5A2.5 2.5 0 0 0 4 21.5v-16Z"/><path d="M4 19h16v2H6.5A2.5 2.5 0 0 1 4 18.5M8 7h8m-8 4h8"/></svg></span>Resources</a>
                    <div class="mc-user-sidebar-mobile-public"><p class="mc-user-sidebar-label">Public</p><a class="mc-user-sidebar-link" asp-controller="Home" asp-action="Index">Home</a><a class="mc-user-sidebar-link" asp-controller="Home" asp-action="Privacy">Privacy Policy</a><a class="mc-user-sidebar-link mc-user-sidebar-link--support" asp-controller="Support" asp-action="Immediate">Need immediate help?</a></div>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="mc-user-sidebar-mobile-logout"><button type="submit">Logout</button></form>
                </nav>
            </aside>
            <div class="mc-user-main">
                <div class="mc-user-main-inner">
                    <main role="main" class="mc-user-page-content pb-3">@RenderBody()</main>
                    <footer class="mc-footer mc-user-footer">
                        <div class="container-fluid mc-footer-inner">
                            <span>&copy; MindCare</span>
                            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                        </div>
                    </footer>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="container mc-layout-content"><main role="main" class="pb-3">@RenderBody()</main></div>
    }

    @if (!hasUserPortalShell)
    {
        <footer class="mc-footer">
            <div class="container-fluid mc-footer-inner">
                <span>&copy; MindCare</span>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
            </div>
        </footer>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
