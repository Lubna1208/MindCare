<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MindCare</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MindCare.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light mc-navbar mb-3">
            <div class="container-fluid">
                <a class="navbar-brand mc-brand" asp-area="" asp-controller="Home" asp-action="Index"><img src="~/images/mindcare-icon.png" alt="MindCare logo" class="mc-brand-mark" style="width: 2.25rem; height: 2.25rem; object-fit: contain;" />MindCare</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link mc-nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link mc-nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                @if (User.IsInRole("Admin"))
                                {
                                    <a class="nav-link mc-nav-link" asp-area="" asp-controller="Admin" asp-action="Index">Dashboard</a>
                                }
                                else if (User.IsInRole("Counsellor"))
                                {
                                    <a class="nav-link mc-nav-link" asp-area="" asp-controller="Counsellor" asp-action="Index">Dashboard</a>
                                }
                                else
                                {
                                    <a class="nav-link mc-nav-link" asp-area="" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                                }
                            </li>
                            @if (User.IsInRole("User"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link mc-nav-link" asp-controller="Mood" asp-action="Index">Mood Tracking</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link mc-nav-link" asp-controller="Assessment" asp-action="Index">Assessment</a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link mc-nav-link" asp-controller="Resources" asp-action="Index">Resources</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="nav-link btn btn-link mc-nav-link mc-nav-logout">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link mc-nav-link" asp-area="" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link mc-nav-link" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mc-footer">
        <div class="container">
            &copy; 2026 - MindCare - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
