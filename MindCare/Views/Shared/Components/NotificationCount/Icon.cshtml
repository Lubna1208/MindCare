@model int
<span class="mc-notification-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" focusable="false"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /></svg>
</span>
@if (Model > 0)
{
    <span class="mc-notification-icon-badge">@(Model > 99 ? "99+" : Model.ToString())</span>
}
