@model IReadOnlyList<MindCare.Models.Notification>
@using MindCare.Models

@{
    ViewData["Title"] = "Notifications";
    var unreadCount = Model.Count(notification => !notification.IsRead);
    var isCounsellor = User.IsInRole(RoleNames.Counsellor);
    var fallbackUrl = isCounsellor ? Url.Action("Index", "Counsellor") : Url.Action("Index", "Dashboard");
    var openChatAppointmentIds = ViewData["OpenChatAppointmentIds"] as HashSet<int> ?? new HashSet<int>();
}

<section class="mc-notifications-page" aria-labelledby="notifications-title">
    <div class="mc-notifications-container">
        <header class="mc-notifications-header">
            <div>
                <p class="mc-notifications-eyebrow">@(isCounsellor ? "Counsellor notifications" : "Notifications")</p>
                <h1 id="notifications-title">Notifications</h1>
                <p>Stay updated on your appointments and account activity.</p>
                <span class="mc-notification-summary">@(unreadCount == 0 ? "You're all caught up" : $"{unreadCount} unread notification{(unreadCount == 1 ? "" : "s")}")</span>
            </div>
            <div class="mc-notifications-header-actions">
                @if (User.IsInRole(RoleNames.User))
                {
                    <a asp-action="Settings" class="mc-notification-settings" aria-label="Notification settings" title="Notification settings"><span aria-hidden="true">⚙</span> Settings</a>
                }
                <button type="button" class="mc-admin-back-button mc-notifications-back" id="mcNotificationsBack"><span aria-hidden="true">&larr;</span> Back</button>
            </div>
        </header>

        @if (!Model.Any())
        {
            <section class="mc-notifications-empty" aria-labelledby="empty-notifications-title">
                <span class="mc-notifications-empty-icon" aria-hidden="true">&#10003;</span>
                <h2 id="empty-notifications-title">You're all caught up</h2>
                <p>You don't have any notifications right now.</p>
            </section>
        }
        else
        {
            <section class="mc-notification-panel" aria-label="Notification list">
                @foreach (var notification in Model)
                {
                    <article class="mc-notification-row @(notification.IsRead ? "" : "mc-notification-row--unread")">
                        <div class="mc-notification-indicator" aria-hidden="true">@if (!notification.IsRead) { <span></span> }</div>
                        <div class="mc-notification-content">
                            <p class="mc-notification-message">@notification.Message</p>
                            <p class="mc-notification-meta">@notification.CreatedAt.ToString("dd MMM yyyy") &middot; @notification.CreatedAt.ToString("h:mm tt") @if (!notification.IsRead) { <span class="mc-notification-unread-label">Unread</span> }</p>
                        </div>
                        <div class="mc-notification-actions">
                            <form asp-action="ToggleRead" method="post">
                                <input type="hidden" name="id" value="@notification.Id" />
                                <button type="submit" class="mc-notification-read-toggle @(notification.IsRead ? "mc-notification-read-toggle--read" : "")" title="@(notification.IsRead ? "Mark as unread" : "Mark as read")">
                                    @if (notification.IsRead)
                                    {
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7M3 4v5h5" /></svg>
                                        <span>Mark as unread</span>
                                    }
                                    else
                                    {
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>
                                        <span>Mark as read</span>
                                    }
                                </button>
                            </form>
                            @if (notification.NotificationType == NotificationTypes.DailyMoodReminder)
                            {
                                <a asp-controller="Mood" asp-action="Index" class="mc-notification-action-primary">Log Mood</a>
                            }
                            else if (notification.NotificationType == NotificationTypes.ChatAvailable && notification.AppointmentId.HasValue && openChatAppointmentIds.Contains(notification.AppointmentId.Value))
                            {
                                <a asp-controller="Messaging" asp-action="Chat" asp-route-appointmentId="@notification.AppointmentId" class="mc-notification-action-primary">Open Chat</a>
                            }
                            else if (notification.AppointmentId.HasValue && isCounsellor)
                            {
                                <a asp-controller="Counsellor" asp-action="BookedAppointments" asp-route-appointmentId="@notification.AppointmentId" class="mc-notification-action-primary">View Appointment</a>
                            }
                            else if (notification.AppointmentId.HasValue)
                            {
                                <a asp-controller="Booking" asp-action="MyAppointments" asp-route-highlightAppointmentId="@notification.AppointmentId" class="mc-notification-action-primary">View Appointment</a>
                            }
                        </div>
                    </article>
                }
            </section>
        }
    </div>
</section>

@section Scripts {
    <script>
        document.getElementById('mcNotificationsBack').addEventListener('click', function () {
            var fallbackUrl = '@fallbackUrl';
            var hasSameSiteReferrer = false;
            try {
                hasSameSiteReferrer = document.referrer && new URL(document.referrer).origin === window.location.origin;
            } catch (_) { }
            if (hasSameSiteReferrer && window.history.length > 1) {
                window.history.back();
            } else {
                window.location.assign(fallbackUrl);
            }
        });
    </script>
}
