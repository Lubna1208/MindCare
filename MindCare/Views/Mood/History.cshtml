@model IEnumerable<MindCare.Models.MoodLog>

@{
    ViewData["Title"] = "Mood History";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mc-mood-history-heading mb-4">
    <h1 class="h3 mc-page-title mb-0">Mood History</h1>
    <a asp-action="Index" class="btn btn-primary mc-track-mood-button">Track Today's Mood</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success mc-mood-success-alert" role="alert"><span aria-hidden="true">✓</span>@successMessage</div>
}

@if (Model.Any())
{
    <div class="table-responsive mc-mood-history-table-wrap">
        <table class="table table-striped align-middle mc-mood-history-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Mood</th>
                    <th>Note</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var moodLog in Model)
                {
                    <tr>
                        <td>@moodLog.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@moodLog.Mood</td>
                        <td>@(string.IsNullOrWhiteSpace(moodLog.Note) ? "—" : moodLog.Note)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <p class="text-muted mc-mood-history-empty"><span aria-hidden="true">☼</span>You have not saved any moods yet.</p>
}
