@model IEnumerable<MindCare.Models.CounsellorProfile>
@using System.Net

@{
    ViewData["Title"] = "Counsellors";
    var counsellorCount = Model.Count();
}

<section class="mc-counsellors-page" aria-labelledby="counsellors-title">
    <div class="mc-counsellors-container">
        <header class="mc-counsellors-header">
            <div>
                <span class="mc-counsellors-eyebrow">Counsellor management</span>
                <h1 id="counsellors-title">Counsellors</h1>
                <p>Manage counsellor profiles and account information.</p>
            </div>
            <div class="mc-counsellors-header-actions">
                <partial name="_AdminBackButton" />
                <a asp-controller="Admin" asp-action="AddCounsellor" class="mc-counsellors-add"><span aria-hidden="true">+</span> Add Counsellor</a>
            </div>
        </header>

        @if (TempData["SuccessMessage"] is string message)
        {
            <div class="mc-counsellors-alert mc-counsellors-alert-success" role="status">@message</div>
        }
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="mc-counsellors-alert mc-counsellors-alert-error" role="alert">@errorMessage</div>
        }

        @if (!Model.Any())
        {
            <section class="mc-counsellors-empty" aria-labelledby="empty-counsellors-title">
                <h2 id="empty-counsellors-title">No counsellors added yet</h2>
                <p>Create your first counsellor profile to get started.</p>
                <a asp-controller="Admin" asp-action="AddCounsellor" class="mc-counsellors-add"><span aria-hidden="true">+</span> Add Counsellor</a>
            </section>
        }
        else
        {
            <div class="mc-counsellors-toolbar">
                <label class="visually-hidden" for="counsellor-search">Search counsellors</label>
                <input id="counsellor-search" class="mc-counsellor-search" type="search" placeholder="Search counsellors..." data-counsellor-search />
                <span class="mc-counsellors-count">@counsellorCount @(counsellorCount == 1 ? "counsellor" : "counsellors")</span>
            </div>

            <div class="mc-counsellors-panel">
                <table class="mc-counsellors-table">
                    <colgroup><col class="mc-counsellor-column-name" /><col class="mc-counsellor-column-email" /><col class="mc-counsellor-column-phone" /><col class="mc-counsellor-column-specialization" /><col class="mc-counsellor-column-qualification" /><col class="mc-counsellor-column-experience" /><col class="mc-counsellor-column-actions" /></colgroup>
                    <thead>
                        <tr><th>Name</th><th>Email</th><th>Phone</th><th>Specialization</th><th>Qualification</th><th>Experience</th><th>Actions</th></tr>
                    </thead>
                    <tbody data-counsellor-list>
                        @foreach (var item in Model)
                        {
                            <tr class="mc-counsellor-row" data-counsellor-row>
                                <td class="mc-counsellor-name-cell" data-label="Name"><span class="mc-counsellor-name"><span class="mc-counsellor-initial" aria-hidden="true">@(string.IsNullOrWhiteSpace(item.ApplicationUser.Name) ? "?" : item.ApplicationUser.Name[..1].ToUpperInvariant())</span><span>@item.ApplicationUser.Name</span></span></td>
                                <td class="mc-counsellor-email" data-label="Email" title="@item.ApplicationUser.Email">@item.ApplicationUser.Email</td>
                                <td class="mc-counsellor-phone" data-label="Phone">@item.Phone</td>
                                <td data-label="Specialization"><span class="mc-specialization-badge">@WebUtility.HtmlDecode(item.Specialization)</span></td>
                                <td class="mc-counsellor-qualification" data-label="Qualification">@item.Qualification</td>
                                <td class="mc-counsellor-experience" data-label="Experience">@item.Experience</td>
                                <td class="mc-counsellor-actions" data-label="Actions"><form asp-controller="Admin" asp-action="DeleteCounsellor" asp-route-id="@item.Id" method="post" data-counsellor-delete-form data-counsellor-name="@item.ApplicationUser.Name"><button type="submit" class="mc-counsellor-delete">Delete</button></form></td>
                            </tr>
                        }
                    </tbody>
                </table>
                <section class="mc-counsellors-no-results" data-counsellor-no-results hidden><h2>No counsellors found</h2><p>Try a different search term.</p></section>
            </div>
        }
    </div>
</section>
