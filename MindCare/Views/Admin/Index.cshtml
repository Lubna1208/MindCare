@{
    ViewData["Title"] = "Admin Dashboard";
}

<section class="mc-admin-page" aria-labelledby="admin-dashboard-title">
    <div class="mc-admin-container">
        <header class="mc-admin-header">
            <span class="mc-admin-eyebrow">Admin portal</span>
            <h1 id="admin-dashboard-title">Admin Dashboard</h1>
            <p>Manage counsellors and review community activity from one place.</p>
        </header>

        <section class="mc-admin-actions-section" aria-labelledby="quick-actions-title">
            <div class="mc-admin-section-heading">
                <h2 id="quick-actions-title">Quick actions</h2>
                <p>Choose an action to manage MindCare administration.</p>
            </div>

            <div class="mc-admin-actions">
                <a class="mc-admin-action-card" asp-controller="Admin" asp-action="AddCounsellor">
                    <span class="mc-admin-action-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 19a6 6 0 0 0-12 0" /><circle cx="9" cy="7" r="4" /><path d="M19 8v6M16 11h6" /></svg></span>
                    <span class="mc-admin-action-content"><span class="mc-admin-action-title">Add Counsellor</span><span class="mc-admin-action-description">Create a new counsellor account and profile.</span></span>
                    <span class="mc-admin-action-arrow">Open <span aria-hidden="true">&rarr;</span></span>
                </a>

                <a class="mc-admin-action-card" asp-controller="Admin" asp-action="Counsellors">
                    <span class="mc-admin-action-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg></span>
                    <span class="mc-admin-action-content"><span class="mc-admin-action-title">View Counsellors</span><span class="mc-admin-action-description">View and manage existing counsellor profiles.</span></span>
                    <span class="mc-admin-action-arrow">View <span aria-hidden="true">&rarr;</span></span>
                </a>

                <a class="mc-admin-action-card" asp-controller="Admin" asp-action="ForumReports">
                    <span class="mc-admin-action-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21v-16a2 2 0 0 1 2-2h11l3 3v15" /><path d="M8 12h8M8 16h5M17 3v4h4" /></svg></span>
                    <span class="mc-admin-action-content"><span class="mc-admin-action-title">Forum Reports</span><span class="mc-admin-action-description">Review reported community content.</span></span>
                    <span class="mc-admin-action-arrow">Review <span aria-hidden="true">&rarr;</span></span>
                </a>
            </div>
        </section>
    </div>
</section>
