@model IReadOnlyList<MindCare.Models.ForumReport>

@{
    ViewData["Title"] = "Forum Reports";
    var pendingReportLabel = Model.Count == 1 ? "1 pending report" : $"{Model.Count} pending reports";
}

<section class="mc-forum-reports-page">
    <div class="mc-forum-reports-container">
        <header class="mc-forum-reports-header">
            <div>
                <p class="mc-eyebrow mb-2">Admin moderation</p>
                <h1>Forum Reports</h1>
                <p class="mc-forum-reports-intro">Review pending community reports and take appropriate moderation action.</p>
                <p class="mc-forum-reports-count mb-0">@pendingReportLabel</p>
            </div>
            <a asp-action="Index" class="mc-forum-reports-back"><span aria-hidden="true">&larr;</span> Back</a>
        </header>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="mc-forum-report-alert mc-forum-report-alert-success" role="status">@successMessage</div>
        }
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="mc-forum-report-alert mc-forum-report-alert-error" role="alert">@errorMessage</div>
        }

        @if (!Model.Any())
        {
            <section class="mc-forum-reports-empty">
                <h2>No pending forum reports</h2>
                <p class="mb-0">There are currently no community reports waiting for review.</p>
            </section>
        }
        else
        {
            foreach (var report in Model)
            {
                <article class="mc-forum-report-card">
                    <header class="mc-report-header">
                        <div>
                            <h2>Report #@report.Id</h2>
                            <p class="mc-report-meta mb-0">@report.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")</p>
                        </div>
                        <span class="mc-report-status">@report.Status</span>
                    </header>

                    <section class="mc-report-reason" aria-label="Report reason">
                        <h3>Report reason</h3>
                        <p class="mb-0">@report.Reason</p>
                    </section>

                    <section class="mc-report-content" aria-label="Reported content">
                        <h3>Reported content</h3>
                        @if (report.Post is not null)
                        {
                            <div class="mc-report-content-copy">
                                <p class="mc-report-meta">Post by Anonymous User</p>
                                <h4>@report.Post.Title</h4>
                                <p class="mb-0">@report.Post.Content</p>
                            </div>
                        }
                        else if (report.Comment is not null)
                        {
                            <div class="mc-report-content-copy">
                                <p class="mc-report-meta">Comment by Anonymous User</p>
                                <p>@report.Comment.Content</p>
                                @if (report.Comment.ForumPost is not null)
                                {
                                    <p class="mc-report-meta mb-0">On post: @report.Comment.ForumPost.Title</p>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="mc-report-removed mb-0">Reported content is no longer available.</p>
                        }
                    </section>

                    <div class="mc-report-actions">
                        @if (report.Post is not null)
                        {
                            <form asp-action="DeleteReportedPost" method="post" onsubmit="return confirm('Remove this reported post?');">
                                <input type="hidden" name="reportId" value="@report.Id" />
                                <button type="submit" class="mc-report-action mc-report-remove">Remove Post</button>
                            </form>
                        }
                        @if (report.Comment is not null)
                        {
                            <form asp-action="DeleteReportedComment" method="post" onsubmit="return confirm('Remove this reported comment?');">
                                <input type="hidden" name="reportId" value="@report.Id" />
                                <button type="submit" class="mc-report-action mc-report-remove">Remove Comment</button>
                            </form>
                        }
                        @if (report.Post is not null || report.Comment is not null)
                        {
                            <form asp-action="DeleteReportedUserAccount" method="post" onsubmit="return confirm('Delete this reported account? This action is more serious and cannot be undone.');">
                                <input type="hidden" name="reportId" value="@report.Id" />
                                <button type="submit" class="mc-report-action mc-report-delete-account">Delete Reported Account</button>
                            </form>
                        }
                        <form asp-action="ResolveForumReport" method="post">
                            <input type="hidden" name="reportId" value="@report.Id" />
                            <button type="submit" class="mc-report-action mc-report-dismiss">Dismiss Report</button>
                        </form>
                    </div>
                </article>
            }
        }
    </div>
</section>
