@model IReadOnlyList<MindCare.Models.ForumReport>
@using MindCare.Models

@{
    ViewData["Title"] = "Forum Reports";
}

<style>
    .mc-page { max-width: 980px; margin: 0 auto; }
    .mc-page h1, .mc-report-title {
        font-family: var(--mc-font-heading, 'Lora', 'Playfair Display', serif);
        color: var(--mc-deep, #2F5D57);
    }
    .mc-report-card {
        background: #fff;
        border: 1px solid var(--mc-pale, #D9F5EF);
        border-radius: 16px;
        padding: 1.2rem 1.35rem;
        box-shadow: 0 6px 18px rgba(47, 93, 87, 0.05);
        margin-bottom: 1rem;
    }
    .mc-meta {
        color: var(--mc-deep, #2F5D57);
        opacity: 0.68;
        font-size: 0.9rem;
    }
    .mc-content {
        color: var(--mc-deep, #2F5D57);
        white-space: pre-wrap;
    }
    .mc-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1rem;
    }
    .mc-btn-danger {
        border: 1px solid #C96A6A;
        color: #C96A6A;
        background: transparent;
        border-radius: 999px;
        padding: 0.45rem 0.9rem;
        font-weight: 600;
    }
    .mc-btn-outline {
        border: 1px solid var(--mc-teal, #5BB9A6);
        color: var(--mc-teal, #5BB9A6);
        background: transparent;
        border-radius: 999px;
        padding: 0.45rem 0.9rem;
        font-weight: 600;
    }
    .mc-empty-state {
        background: var(--mc-pale, #D9F5EF);
        border-radius: 16px;
        padding: 1.5rem;
        color: var(--mc-deep, #2F5D57);
    }
</style>

<div class="mc-page">
    <h1 class="h3 mb-3">Forum Reports</h1>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success">@successMessage</div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (!Model.Any())
    {
        <div class="mc-empty-state">No pending forum reports.</div>
    }
    else
    {
        foreach (var report in Model)
        {
            <article class="mc-report-card">
                <div class="d-flex justify-content-between gap-2 flex-wrap">
                    <div>
                        <h2 class="h5 mc-report-title mb-1">Report #@report.Id</h2>
                        <div class="mc-meta">@report.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, h:mm tt") · @report.Status</div>
                    </div>
                    <span class="badge text-bg-warning align-self-start">Pending</span>
                </div>

                <div class="mt-3">
                    <strong>Reason</strong>
                    <p class="mc-content mb-0">@report.Reason</p>
                </div>

                <div class="mt-3">
                    <strong>Reported content</strong>
                    @if (report.Post is not null)
                    {
                        <div class="mt-2">
                            <div class="mc-meta">Post by Anonymous User</div>
                            <h3 class="h6 mb-1">@report.Post.Title</h3>
                            <p class="mc-content mb-0">@report.Post.Content</p>
                        </div>
                    }
                    else if (report.Comment is not null)
                    {
                        <div class="mt-2">
                            <div class="mc-meta">Comment by Anonymous User</div>
                            <p class="mc-content mb-2">@report.Comment.Content</p>
                            @if (report.Comment.ForumPost is not null)
                            {
                                <div class="mc-meta">On post: @report.Comment.ForumPost.Title</div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="mc-meta mb-0 mt-2">The reported content has already been removed.</p>
                    }
                </div>

                <div class="mc-actions">
                    @if (report.Post is not null)
                    {
                        <form asp-action="DeleteReportedPost" method="post">
                            <input type="hidden" name="reportId" value="@report.Id" />
                            <button type="submit" class="mc-btn-danger">Remove Post</button>
                        </form>
                    }
                    @if (report.Comment is not null)
                    {
                        <form asp-action="DeleteReportedComment" method="post">
                            <input type="hidden" name="reportId" value="@report.Id" />
                            <button type="submit" class="mc-btn-danger">Remove Comment</button>
                        </form>
                    }
                    @if (report.Post is not null || report.Comment is not null)
                    {
                        <form asp-action="DeleteReportedUserAccount" method="post">
                            <input type="hidden" name="reportId" value="@report.Id" />
                            <button type="submit" class="mc-btn-danger">Delete Reported Account</button>
                        </form>
                    }
                    <form asp-action="ResolveForumReport" method="post">
                        <input type="hidden" name="reportId" value="@report.Id" />
                        <button type="submit" class="mc-btn-outline">Dismiss Report</button>
                    </form>
                </div>
            </article>
        }
    }

    <a asp-action="Index" class="btn btn-link">Back to Admin Dashboard</a>
</div>
