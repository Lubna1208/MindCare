@model MindCare.ViewModels.AddCounsellorViewModel

@{
    ViewData["Title"] = "Add Counsellor";
}

<style>
    .mc-page { max-width: 900px; margin: 0 auto; }
    .mc-page h1 {
        font-family: var(--mc-font-heading, 'Lora', 'Playfair Display', serif);
        color: var(--mc-deep, #2F5D57);
    }
    .mc-form-card {
        background: #fff;
        border: 1px solid var(--mc-pale, #D9F5EF);
        border-radius: 20px;
        padding: 1.75rem 2rem;
        box-shadow: 0 8px 24px rgba(47, 93, 87, 0.06);
    }
    .mc-form-card .form-label {
        color: var(--mc-deep, #2F5D57);
        font-weight: 600;
        font-size: 0.92rem;
    }
    .mc-form-card .form-control {
        border: 1px solid var(--mc-pale, #D9F5EF);
        border-radius: 12px;
        padding: 0.6rem 0.9rem;
        background: var(--mc-mist, #F7FFFD);
    }
    .mc-form-card .form-control:focus {
        border-color: var(--mc-teal, #5BB9A6);
        box-shadow: 0 0 0 0.2rem rgba(91, 185, 166, 0.25);
        background: #fff;
    }
    .mc-btn-primary {
        background: var(--mc-teal, #5BB9A6);
        border: none;
        color: #fff;
        border-radius: 999px;
        padding: 0.6rem 1.4rem;
        font-weight: 600;
        transition: background 0.2s ease, transform 0.2s ease;
    }
    .mc-btn-primary:hover { background: var(--mc-deep, #2F5D57); color: #fff; transform: translateY(-1px); }
    .mc-btn-outline {
        border: 1px solid var(--mc-deep, #2F5D57);
        color: var(--mc-deep, #2F5D57);
        background: transparent;
        border-radius: 999px;
        padding: 0.6rem 1.4rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        margin-left: 0.6rem;
        transition: background 0.2s ease, color 0.2s ease;
    }
    .mc-btn-outline:hover { background: var(--mc-pale, #D9F5EF); color: var(--mc-deep, #2F5D57); }
</style>

<div class="mc-page">
    <h1 class="h3 mb-3">Add Counsellor</h1>

    <div class="mc-form-card">
        <form asp-action="AddCounsellor" method="post" class="row g-3">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="col-md-6">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" autocomplete="name" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" autocomplete="tel" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Specialization" class="form-label"></label>
                <input asp-for="Specialization" class="form-control" />
                <span asp-validation-for="Specialization" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Qualification" class="form-label"></label>
                <input asp-for="Qualification" class="form-control" />
                <span asp-validation-for="Qualification" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Experience" class="form-label"></label>
                <input asp-for="Experience" class="form-control" />
                <span asp-validation-for="Experience" class="text-danger"></span>
            </div>

            <div class="col-12 mt-2">
                <button type="submit" class="mc-btn-primary">Create Counsellor</button>
                <a asp-controller="Admin" asp-action="Index" class="mc-btn-outline">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
