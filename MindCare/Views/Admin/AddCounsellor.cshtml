@model MindCare.ViewModels.AddCounsellorViewModel

@{
    ViewData["Title"] = "Add Counsellor";
}

<section class="mc-counsellor-create-page" aria-labelledby="add-counsellor-title">
    <div class="mc-counsellor-create-container">
        <header class="mc-counsellor-create-header mc-counsellor-page-header">
            <div class="mc-counsellor-page-header-content">
                    <span class="mc-counsellor-eyebrow">Counsellor management</span>
                    <h1 id="add-counsellor-title">Add Counsellor</h1>
                    <p>Create a counsellor account and professional profile.</p>
            </div>
            <div class="mc-counsellor-back">
                <partial name="_AdminBackButton" />
            </div>
        </header>

        <form asp-action="AddCounsellor" method="post" class="mc-counsellor-form">
            <div asp-validation-summary="ModelOnly" class="text-danger mc-counsellor-validation" role="alert"></div>

            <section class="mc-form-section" aria-labelledby="account-information-title">
                <div class="mc-form-section-heading">
                    <h2 id="account-information-title">Account information</h2>
                    <p>Set up the counsellor's account details.</p>
                </div>
                <div class="mc-field-grid">
                    <div class="mc-counsellor-field"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" autocomplete="name" minlength="2" maxlength="100" /><span asp-validation-for="FullName" class="text-danger"></span></div>
                    <div class="mc-counsellor-field"><label asp-for="Email" class="form-label"></label><input asp-for="Email" type="email" class="form-control" maxlength="254" autocomplete="email" /><span asp-validation-for="Email" class="text-danger"></span></div>
                    <div class="mc-counsellor-field"><label asp-for="Password" class="form-label"></label><div class="mc-password-wrap"><input asp-for="Password" id="mc-add-counsellor-password" type="password" class="form-control" autocomplete="new-password" minlength="8" maxlength="64" /><button type="button" class="mc-password-toggle" data-show-label="Show password" data-hide-label="Hide password" aria-controls="mc-add-counsellor-password" aria-label="Show password" aria-pressed="false" title="Show password"><span class="mc-icon-show"><svg class="mc-eye-icon mc-eye-show" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" /><circle cx="12" cy="12" r="3" /></svg></span><span class="mc-icon-hide" hidden><svg class="mc-eye-icon mc-eye-hide" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2 2 20 20" /><path d="M6.71 6.71A10.43 10.43 0 0 0 2.06 11.65a1 1 0 0 0 0 .7 10.75 10.75 0 0 0 15.23 5.94" /><path d="M10.73 5.08A10.8 10.8 0 0 1 12 5c4.4 0 8.17 2.65 9.94 6.65a1 1 0 0 1 0 .7 10.5 10.5 0 0 1-2.21 3.31" /><path d="M14.12 14.12A3 3 0 0 1 9.88 9.88" /></svg></span></button></div><span asp-validation-for="Password" class="text-danger"></span></div>
                    <div class="mc-counsellor-field"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" type="tel" class="form-control" autocomplete="tel" inputmode="numeric" pattern="[0-9]{10,15}" minlength="10" maxlength="15" data-digits-only /><span asp-validation-for="Phone" class="text-danger"></span></div>
                </div>
            </section>

            <section class="mc-form-section" aria-labelledby="professional-information-title">
                <div class="mc-form-section-heading">
                    <h2 id="professional-information-title">Professional information</h2>
                    <p>All fields should reflect the counsellor's actual professional information.</p>
                </div>
                <div class="mc-professional-grid">
                    <div class="mc-counsellor-field"><label asp-for="Specialization" class="form-label"></label><input asp-for="Specialization" class="form-control" list="specialization-options" placeholder="Select or type a specialization" /><datalist id="specialization-options"><option value="General Counselling" /><option value="Anxiety &amp; Stress" /><option value="Depression Support" /><option value="Child &amp; Adolescent Counselling" /><option value="Student &amp; Academic Counselling" /><option value="Relationship Counselling" /><option value="Family Counselling" /><option value="Grief &amp; Loss" /><option value="Trauma Support" /><option value="Anger Management" /><option value="Career Counselling" /><option value="Personal Development &amp; Wellbeing" /></datalist><small class="mc-form-help">Choose a suggestion or enter another specialization.</small><span asp-validation-for="Specialization" class="text-danger"></span></div>
                    <div class="mc-counsellor-field"><label asp-for="Qualification" class="form-label"></label><input asp-for="Qualification" class="form-control" list="qualification-options" placeholder="Select or type a qualification" /><datalist id="qualification-options"><option value="Bachelor's in Psychology" /><option value="Master's in Psychology" /><option value="MA/MSc in Counselling Psychology" /><option value="MA/MSc in Clinical Psychology" /><option value="Master's in Social Work" /><option value="Diploma / Postgraduate Diploma in Counselling" /><option value="Professional Counselling Training" /></datalist><small class="mc-form-help">Choose a suggestion or enter another qualification.</small><span asp-validation-for="Qualification" class="text-danger"></span></div>
                    <div class="mc-counsellor-field"><label asp-for="Experience" class="form-label"></label><input asp-for="Experience" class="form-control" list="experience-options" placeholder="e.g. 5 years" /><datalist id="experience-options"><option value="Less than 1 year" /><option value="1 year" /><option value="2 years" /><option value="3 years" /><option value="5 years" /><option value="10+ years" /></datalist><small class="mc-form-help">Enter professional experience in years.</small><span asp-validation-for="Experience" class="text-danger"></span></div>
                </div>
            </section>

            <div class="mc-counsellor-form-actions"><button type="submit" class="mc-counsellor-submit">Create Counsellor</button><a asp-controller="Admin" asp-action="Index" class="mc-counsellor-cancel">Cancel</a></div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
