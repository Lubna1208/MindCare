@model MindCare.Models.ApplicationUser

@{
    ViewData["Title"] = "Dashboard";
}

<div class="mc-dashboard">
    <section class="mc-welcome-banner mb-4" aria-labelledby="dashboard-title">
        <div class="mc-avatar" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s-6-3.8-6-10a3.5 3.5 0 0 1 6-2.4A3.5 3.5 0 0 1 18 11c0 6.2-6 10-6 10Z" /><path d="M12 8.6v8.2" /></svg>
        </div>
        <div>
            <p class="mc-eyebrow mb-1">Your wellbeing space</p>
            <h1 id="dashboard-title" class="mc-page-title mb-1">User Dashboard</h1>
            <p class="mc-welcome-copy mb-0">Welcome, @Model.Name.</p>
        </div>
    </section>

    <div class="row g-4">
        <div class="col-12 col-lg-5">
            <section class="mc-card mc-profile-card h-100" aria-labelledby="profile-title">
                <div class="mc-card-heading">
                    <span class="mc-heading-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="3.25" /><path d="M5.5 20c.5-3.4 3.05-5.25 6.5-5.25s6 1.85 6.5 5.25" /></svg>
                    </span>
                    <h2 id="profile-title" class="mc-section-title mb-0">Profile</h2>
                </div>
                <div class="mc-profile-details">
                    <p class="mb-3"><strong>Name</strong><span>@Model.Name</span></p>
                    <p class="mb-0"><strong>Email</strong><span>@Model.Email</span></p>
                </div>
            </section>
        </div>

        <div class="col-12 col-lg-7">
            <section class="mc-card mc-features-card h-100" aria-labelledby="features-title">
                <div class="mc-card-heading">
                    <span class="mc-heading-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20V10" /><path d="M8 20v-5M16 20v-7" /><path d="M5 20h14" /></svg>
                    </span>
                    <div>
                        <h2 id="features-title" class="mc-section-title mb-1">MindCare Features</h2>
                        <p class="mc-section-intro mb-0">Small steps can support a steadier day.</p>
                    </div>
                </div>
                <ul class="mc-feature-grid">
                    <li><a class="mc-feature-link" asp-controller="Mood" asp-action="Index"><span class="mc-feature-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="8" /><path d="M8.5 14.5c1 .9 2.2 1.35 3.5 1.35s2.5-.45 3.5-1.35M9 9.5h.01M15 9.5h.01" /></svg></span><span>Mood tracking</span><span class="mc-arrow" aria-hidden="true">→</span></a></li>
                    <li><a class="mc-feature-link" asp-controller="Assessment" asp-action="Index"><span class="mc-feature-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 4h8M9 3v2M15 3v2M7 7h10v13H7z" /><path d="m9.5 12 1.5 1.5 3.5-3.5M9.5 17h5" /></svg></span><span>Take Assessment</span><span class="mc-arrow" aria-hidden="true">→</span></a></li>
                    <li><a class="mc-feature-link" asp-controller="Resources" asp-action="Index"><span class="mc-feature-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 4.5A2.5 2.5 0 0 1 7.5 2H19v17.5H7.5A2.5 2.5 0 0 0 5 22z" /><path d="M5 4.5v15" /></svg></span><span>Resources</span><span class="mc-arrow" aria-hidden="true">→</span></a></li>
                    <li><a class="mc-feature-link" asp-controller="Booking" asp-action="Index"><span class="mc-feature-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s-6-3.8-6-10a3.5 3.5 0 0 1 6-2.4A3.5 3.5 0 0 1 18 11c0 6.2-6 10-6 10Z" /><path d="M12 8.6v8.2" /></svg></span><span>Find/Book Counsellor</span><span class="mc-arrow" aria-hidden="true">&rarr;</span></a></li>
                    <li><a class="mc-feature-link" asp-controller="Booking" asp-action="MyAppointments"><span class="mc-feature-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 3v3M16 3v3M4 8h16M6 5h12a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z" /><path d="m9 14 2 2 4-4" /></svg></span><span>My Appointments</span><span class="mc-arrow" aria-hidden="true">&rarr;</span></a></li>
                </ul>
            </section>
        </div>
    </div>

    <form asp-controller="Account" asp-action="Logout" method="post" class="mc-dashboard-logout">
        <button type="submit" class="btn btn-outline-danger mc-logout-button">Logout</button>
    </form>
</div>
