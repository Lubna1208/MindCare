@model MindCare.Models.ApplicationUser

@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="h3 mb-3">User Dashboard</h1>
<p>Welcome, @Model.Name.</p>

<section class="mb-3">
    <h2 class="h5">Profile</h2>
    <p class="mb-1"><strong>Name:</strong> @Model.Name</p>
    <p class="mb-0"><strong>Email:</strong> @Model.Email</p>
</section>

<section class="mb-3">
    <h2 class="h5">MindCare Features</h2>
    <ul>
        <li><a asp-controller="Mood" asp-action="Index">Mood tracking</a></li>
        <li><a asp-controller="Assessment" asp-action="Index">Take Assessment</a></li>
        <li><a asp-controller="Resources" asp-action="Index">Resources</a></li>
        <li>Counselling</li>
    </ul>
</section>

<form asp-controller="Account" asp-action="Logout" method="post">
    <button type="submit" class="btn btn-outline-danger">Logout</button>
</form>
