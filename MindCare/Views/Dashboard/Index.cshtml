@model MindCare.Models.ApplicationUser

@{
    ViewData["Title"] = "Dashboard";
}

<div class="mc-dashboard mc-user-dashboard">
    <section class="mc-dashboard-hero" aria-labelledby="dashboard-title">
        <span class="mc-dashboard-hero-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 20.2S5.1 16.4 5.1 10.8a3.7 3.7 0 0 1 6.5-2.4L12 9l.4-.6a3.7 3.7 0 0 1 6.5 2.4c0 5.6-6.9 9.4-6.9 9.4Z"/><path d="M12 5.5V2.8m5.1 4.1 1.8-1.8M19 11.1h2.6m-17.2 0H2.1M6.9 6.9 5.1 5.1"/><path d="M9.2 13.1c.75.8 1.68 1.2 2.8 1.2s2.05-.4 2.8-1.2"/></svg></span>
        <div><p class="mc-dashboard-eyebrow">Your wellbeing space</p><h1 id="dashboard-title">Welcome back, @Model.Name</h1><p>How are you feeling today? Take a small moment to check in with yourself.</p></div>
    </section>

    <section class="mc-dashboard-section" aria-labelledby="quick-actions-title">
        <header class="mc-dashboard-section-heading"><p class="mc-dashboard-eyebrow">Start where you are</p><h2 id="quick-actions-title">Quick actions</h2></header>
        <div class="mc-dashboard-quick-grid">
            <article class="mc-dashboard-action-card"><span class="mc-dashboard-action-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="M8.5 14.5c1 .9 2.2 1.35 3.5 1.35s2.5-.45 3.5-1.35M9 9.5h.01M15 9.5h.01"/></svg></span><h3>How are you feeling today?</h3><p>Notice your mood and keep a private record of what is on your mind.</p><a class="mc-dashboard-action-button" asp-controller="Mood" asp-action="Index">Track My Mood</a></article>
            <article class="mc-dashboard-action-card"><span class="mc-dashboard-action-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 4h8M9 3v2M15 3v2M7 7h10v13H7z"/><path d="m9.5 12 1.5 1.5 3.5-3.5M9.5 17h5"/></svg></span><h3>Check in with yourself</h3><p>Use a brief assessment to reflect on how things have been feeling lately.</p><a class="mc-dashboard-action-button" asp-controller="Assessment" asp-action="Index">Take Assessment</a></article>
            <article class="mc-dashboard-action-card"><span class="mc-dashboard-action-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 4.5A2.5 2.5 0 0 1 7.5 2H19v17.5H7.5A2.5 2.5 0 0 0 5 22z"/><path d="M5 4.5v15"/></svg></span><h3>Explore resources</h3><p>Find calm, practical reading for everyday wellbeing and support.</p><a class="mc-dashboard-action-button" asp-controller="Resources" asp-action="Index">Browse Resources</a></article>
        </div>
    </section>

    <section class="mc-dashboard-support" aria-labelledby="immediate-help-title">
        <span class="mc-dashboard-support-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 21s-6-3.8-6-10a3.5 3.5 0 0 1 6-2.4A3.5 3.5 0 0 1 18 11c0 6.2-6 10-6 10Z"/><path d="M12 8.6v8.2"/></svg></span>
        <div class="mc-dashboard-support-content"><p class="mc-dashboard-eyebrow">Support when it matters</p><h2 id="immediate-help-title">Need immediate help?</h2><p>Sometimes things can feel overwhelming. Find trusted contacts and next steps for support right now.</p></div>
        <a class="mc-dashboard-support-action" asp-controller="Support" asp-action="Immediate">Get Immediate Support</a>
    </section>

    <section class="mc-dashboard-care" aria-labelledby="care-title">
        <header class="mc-dashboard-section-heading"><p class="mc-dashboard-eyebrow">Your care</p><h2 id="care-title">Continue your care</h2><p>Connect with a counsellor or manage your appointments whenever you are ready.</p></header>
        <div class="mc-dashboard-care-grid">
            <article class="mc-dashboard-care-item"><span aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="10.5" cy="10" r="4"/><path d="m14 14 5 5M3 21c.7-3.1 3.2-5 6-5"/></svg></span><div><h3>Find a Counsellor</h3><p>Find a professional who fits your needs.</p><a asp-controller="Booking" asp-action="Index">Find Counsellor <b aria-hidden="true">→</b></a></div></article>
            <article class="mc-dashboard-care-item"><span aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3v4m8-4v4M4 10h16"/></svg></span><div><h3>My Appointments</h3><p>View and manage your scheduled sessions.</p><a asp-controller="Booking" asp-action="MyAppointments">View Appointments <b aria-hidden="true">→</b></a></div></article>
        </div>
    </section>
</div>
