@model MindCare.ViewModels.TrustedContactViewModel

@{
    ViewData["Title"] = "Edit Trusted Person";
}

<section class="mc-trusted-add-page">
    <a asp-action="TrustedPeople" class="mc-trusted-add-back"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 5-7 7 7 7" /><path d="M7 12h12" /></svg>Back to Trusted People</a>
    <section class="mc-trusted-add-card" aria-labelledby="editTrustedPersonTitle">
        <header class="mc-trusted-add-header">
            <p>YOUR SUPPORT CIRCLE</p>
            <h1 id="editTrustedPersonTitle">Edit Trusted Person</h1>
            <span>Update this person's contact details when needed.</span>
        </header>

        <form method="post" class="mc-trusted-add-form">
            <partial name="_TrustedPersonForm" model="Model" />
            <p class="mc-trusted-add-privacy">Only you can manage your trusted contacts.</p>
            <div class="mc-trusted-add-actions">
                <button type="submit" class="mc-trusted-add-save"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5.5A1.5 1.5 0 0 1 6.5 4h9L20 8.5V19a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 19V5.5Z" /><path d="M7 4v5h9V4m-8 16v-6h8v6" /></svg>Save Changes</button>
                <a asp-action="TrustedPeople" class="mc-trusted-add-cancel">Cancel</a>
            </div>
        </form>
    </section>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
