@model MindCare.ViewModels.ForgotPasswordViewModel
@{ ViewData["Title"] = "Forgot Password"; var accountLabel = ViewData["AccountLabel"]?.ToString() ?? "Account recovery"; var forgotPasswordAction = ViewData["ForgotPasswordAction"]?.ToString() ?? "ForgotPassword"; var accountDescription = ViewData["ForgotPasswordDescription"]?.ToString() ?? "Enter the email address associated with your MindCare account. If an eligible account exists, we’ll send password-reset instructions."; }

<section class="mc-forgot-password" aria-labelledby="forgot-password-title">
    <div class="mc-forgot-password-card">
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="mc-reset-confirmation" role="status">
                <span class="mc-reset-confirmation-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3.5 6.5 12 12l8.5-5.5" /><rect x="3.5" y="5" width="17" height="14" rx="2" /><path d="m9 15 2 2 4-4" /></svg></span>
                <p class="mc-forgot-password-eyebrow">@accountLabel</p>
                <h1 id="forgot-password-title">Check your email</h1>
                <div class="mc-reset-confirmation-panel"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 6.5 12 12l8.5-5.5" /><rect x="3.5" y="5" width="17" height="14" rx="2" /><path d="m9 15 2 2 4-4" /></svg><p>@successMessage</p></div>
                <p class="mc-reset-confirmation-help">If you requested a reset for an eligible account, please check your inbox and spam or junk folder.</p>
                <a asp-action="Login" class="mc-reset-confirmation-back">Back to Login</a>
            </div>
        }
        else
        {
            <header class="mc-forgot-password-header">
                <span class="mc-forgot-password-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3.5 6.5 12 12l8.5-5.5" /><rect x="3.5" y="5" width="17" height="14" rx="2" /><path d="M15.5 10.5V9a3.5 3.5 0 0 0-7 0v1.5" /></svg></span>
                <p class="mc-forgot-password-eyebrow">@accountLabel</p>
                <h1 id="forgot-password-title">Forgot Password</h1>
                <p>@accountDescription</p>
            </header>
            <aside class="mc-forgot-password-info" aria-label="Privacy information"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.8 19 5.7v5.1c0 4.4-2.9 8.4-7 10.4-4.1-2-7-6-7-10.4V5.7l7-2.9Z" /><path d="M9 12h6m-3-3v6" /></svg><span>For your security, we won’t confirm whether an email address is registered.</span></aside>
            @if (TempData["ErrorMessage"] is string errorMessage) { <div class="mc-forgot-password-error" role="alert">@errorMessage</div> }
            <form asp-action="@forgotPasswordAction" method="post" class="mc-forgot-password-form" data-forgot-password-form>
                <div asp-validation-summary="ModelOnly" class="mc-forgot-password-validation" role="alert"></div>
                <div class="mc-forgot-password-field"><label asp-for="Email"></label><input asp-for="Email" type="email" class="form-control" maxlength="254" autocomplete="email" /><span asp-validation-for="Email"></span></div>
                <button type="submit" class="mc-forgot-password-submit" data-forgot-password-submit><span data-forgot-password-label>Send Reset Link</span></button>
                <a asp-action="Login" class="mc-forgot-password-back">Back to Login</a>
            </form>
        }
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
