@model MindCare.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="mc-auth-page">
    <div class="mc-auth-container">
        <section class="mc-login-card" aria-labelledby="login-title">
            <header class="mc-auth-header">
                <span class="mc-auth-accent" aria-hidden="true"></span>
                <h1 id="login-title">Login</h1>
                <p>Welcome back &mdash; glad to see you again.</p>
            </header>

            <form asp-action="Login" method="post" class="mc-auth-form">
                @if (!string.IsNullOrWhiteSpace(returnUrl))
                {
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                }
                <div asp-validation-summary="ModelOnly" class="text-danger mc-auth-validation" role="alert"></div>

                <div class="mc-form-group">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mc-form-group">
                    <label asp-for="Password" class="form-label"></label>
                    <div class="mc-password-wrap">
                        <input asp-for="Password" id="mc-login-password" type="password" class="form-control" autocomplete="current-password" />
                        <button type="button" class="mc-password-toggle" data-password-toggle data-show-label="Show password" data-hide-label="Hide password" aria-controls="mc-login-password" aria-label="Show password" aria-pressed="false" title="Show password">
                            <span class="mc-icon-show"><svg class="mc-eye-icon mc-eye-show" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" /><circle cx="12" cy="12" r="3" /></svg></span>
                            <span class="mc-icon-hide" hidden><svg class="mc-eye-icon mc-eye-hide" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2 2 20 20" /><path d="M6.71 6.71A10.43 10.43 0 0 0 2.06 11.65a1 1 0 0 0 0 .7 10.75 10.75 0 0 0 15.23 5.94" /><path d="M10.73 5.08A10.8 10.8 0 0 1 12 5c4.4 0 8.17 2.65 9.94 6.65a1 1 0 0 1 0 .7 10.5 10.5 0 0 1-2.21 3.31" /><path d="M14.12 14.12A3 3 0 0 1 9.88 9.88" /></svg></span>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <button type="submit" class="btn mc-auth-submit">Login</button>
            </form>

            <p class="mc-auth-switch mc-auth-forgot"><a asp-controller="Account" asp-action="ForgotPassword">Forgot password?</a></p>
            <p class="mc-auth-switch">Need an account? <a asp-controller="Account" asp-action="Register">Register</a></p>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
