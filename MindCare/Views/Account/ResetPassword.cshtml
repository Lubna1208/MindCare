@model MindCare.ViewModels.ResetPasswordViewModel
@{ ViewData["Title"] = "Reset Password"; var accountLabel = ViewData["AccountLabel"]?.ToString() ?? "Counsellor account"; var resetPasswordAction = ViewData["ResetPasswordAction"]?.ToString() ?? "ResetPassword"; var resetPasswordTitle = ViewData["ResetPasswordTitle"]?.ToString() ?? "Reset Password"; var resetPasswordText = ViewData["ResetPasswordText"]?.ToString() ?? "Choose a new password for your MindCare counsellor account."; var cancelAction = ViewData["ResetCancelAction"]?.ToString() ?? "Login"; }
<section class="mc-security-page" aria-labelledby="reset-password-title">
    <div class="mc-security-card">
        <header class="mc-security-header"><p>@accountLabel</p><h1 id="reset-password-title">@resetPasswordTitle</h1><span>@resetPasswordText</span></header>
        <form asp-action="@resetPasswordAction" method="post" class="mc-security-form">
            <input asp-for="Token" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="mc-security-field"><label asp-for="Email"></label><input asp-for="Email" type="email" class="form-control" autocomplete="email" readonly /><span asp-validation-for="Email" class="text-danger"></span></div>
            <div class="mc-security-field"><label asp-for="NewPassword"></label><div class="mc-password-wrap"><input asp-for="NewPassword" id="mc-reset-new-password" class="form-control" autocomplete="new-password" /><button type="button" class="mc-password-toggle" data-password-toggle data-show-label="Show new password" data-hide-label="Hide new password" aria-controls="mc-reset-new-password" aria-label="Show new password"><span class="mc-icon-show"><svg class="mc-eye-icon mc-eye-show" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" /><circle cx="12" cy="12" r="3" /></svg></span><span class="mc-icon-hide" hidden><svg class="mc-eye-icon mc-eye-hide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2 2 20 20" /><path d="M6.71 6.71A10.43 10.43 0 0 0 2.06 11.65a1 1 0 0 0 0 .7 10.75 10.75 0 0 0 15.23 5.94" /><path d="M10.73 5.08A10.8 10.8 0 0 1 12 5c4.4 0 8.17 2.65 9.94 6.65a1 1 0 0 1 0 .7 10.5 10.5 0 0 1-2.21 3.31" /><path d="M14.12 14.12A3 3 0 0 1 9.88 9.88" /></svg></span></button></div><span asp-validation-for="NewPassword" class="text-danger"></span></div>
            <div class="mc-security-field"><label asp-for="ConfirmPassword"></label><div class="mc-password-wrap"><input asp-for="ConfirmPassword" id="mc-reset-confirm-password" class="form-control" autocomplete="new-password" /><button type="button" class="mc-password-toggle" data-password-toggle data-show-label="Show confirmation password" data-hide-label="Hide confirmation password" aria-controls="mc-reset-confirm-password" aria-label="Show confirmation password"><span class="mc-icon-show"><svg class="mc-eye-icon mc-eye-show" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" /><circle cx="12" cy="12" r="3" /></svg></span><span class="mc-icon-hide" hidden><svg class="mc-eye-icon mc-eye-hide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2 2 20 20" /><path d="M6.71 6.71A10.43 10.43 0 0 0 2.06 11.65a1 1 0 0 0 0 .7 10.75 10.75 0 0 0 15.23 5.94" /><path d="M10.73 5.08A10.8 10.8 0 0 1 12 5c4.4 0 8.17 2.65 9.94 6.65a1 1 0 0 1 0 .7 10.5 10.5 0 0 1-2.21 3.31" /><path d="M14.12 14.12A3 3 0 0 1 9.88 9.88" /></svg></span></button></div><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
            <div class="mc-security-actions"><button type="submit" class="mc-security-primary">Reset Password</button><a asp-action="@cancelAction" class="mc-security-secondary">Cancel</a></div>
        </form>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
