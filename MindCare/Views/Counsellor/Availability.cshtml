@model MindCare.ViewModels.CounsellorAvailabilityViewModel

@{
    ViewData["Title"] = "My Availability";
    string FormatTime(TimeSpan time) => DateTime.Today.Add(time).ToString("h:mm tt");
    var groupedSlots = Model.Slots.GroupBy(slot => slot.Date.Date);
    var availabilityDays = groupedSlots.Count();
    var totalSlots = Model.Slots.Count;
    var bookedSlots = Model.Slots.Count(slot => slot.IsBooked);
    var availableSlots = totalSlots - bookedSlots;
}

<section class="mc-availability-page" aria-labelledby="availability-title">
    <div class="mc-availability-container">
        <header class="mc-availability-header">
            <div>
                <p class="mc-availability-eyebrow">Counsellor schedule</p>
                <h1 id="availability-title">My Availability</h1>
                <p>Set your available time slots for counselling sessions.</p>
            </div>
            <button type="button" class="mc-admin-back-button mc-availability-back" onclick="history.back()"><span aria-hidden="true">&larr;</span> Back</button>
        </header>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="mc-availability-alert mc-availability-alert--success" role="status" data-auto-dismiss>@successMessage</div>
        }
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="mc-availability-alert mc-availability-alert--error" role="alert" data-auto-dismiss>@errorMessage</div>
        }
        <div asp-validation-summary="ModelOnly" class="mc-availability-alert mc-availability-alert--error mc-availability-validation" role="alert" data-auto-dismiss></div>

        <section class="mc-availability-form-card" aria-labelledby="create-availability-title">
            <div class="mc-availability-card-header">
                <h2 id="create-availability-title">Create Availability</h2>
                <p>Choose a date and time range to generate session slots.</p>
            </div>
            <form asp-action="Availability" method="post">
                <div class="mc-availability-form-grid">
                    <div class="mc-availability-field"><label asp-for="Form.Date"></label><input asp-for="Form.Date" class="form-control" type="date" /><span asp-validation-for="Form.Date"></span></div>
                    <div class="mc-availability-field"><label asp-for="Form.StartTime"></label><input asp-for="Form.StartTime" class="form-control" type="time" /><span asp-validation-for="Form.StartTime"></span></div>
                    <div class="mc-availability-field"><label asp-for="Form.EndTime"></label><input asp-for="Form.EndTime" class="form-control" type="time" /><span asp-validation-for="Form.EndTime"></span></div>
                    <div class="mc-availability-field mc-duration-field"><label asp-for="Form.SlotDurationMinutes">Slot Duration</label><div class="mc-duration-input-wrap"><input asp-for="Form.SlotDurationMinutes" class="form-control" min="1" /><span>minutes</span></div><span asp-validation-for="Form.SlotDurationMinutes"></span></div>
                </div>
                <button type="submit" class="mc-availability-submit">Generate Slots</button>
            </form>
        </section>

        <section class="mc-availability-list-section" aria-labelledby="your-availability-title">
            <div class="mc-availability-list-header"><h2 id="your-availability-title">Your Availability</h2>@if (totalSlots > 0) { <p>@availabilityDays day@(availabilityDays == 1 ? "" : "s") &middot; @totalSlots slot@(totalSlots == 1 ? "" : "s") &middot; @bookedSlots booked &middot; @availableSlots available</p> }</div>
            @if (!Model.Slots.Any())
            {
                <div class="mc-availability-empty-state"><h3>No availability created yet</h3><p>Add your first available time range above to generate session slots.</p></div>
            }
            else
            {
                var isFirstDate = true;
                @foreach (var group in groupedSlots)
                {
                    var groupBooked = group.Count(slot => slot.IsBooked);
                    var groupAvailable = group.Count() - groupBooked;
                    var isOpen = isFirstDate;
                    var dayId = $"availability-day-{group.Key:yyyyMMdd}";
                    isFirstDate = false;
                    <section class="mc-availability-day">
                        <button type="button" class="mc-availability-day-toggle" aria-expanded="@isOpen.ToString().ToLowerInvariant()" aria-controls="@dayId">
                            <span class="mc-availability-day-heading">@group.Key.ToString("dd MMMM yyyy")</span>
                            <span class="mc-availability-day-summary">@group.Count() slot@(group.Count() == 1 ? "" : "s") &middot; <span class="mc-availability-day-booked">@groupBooked booked</span> &middot; @groupAvailable available</span>
                            <svg class="mc-availability-day-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                        </button>
                        <div id="@dayId" class="mc-availability-day-content" @(isOpen ? "" : "hidden")>
                            @foreach (var slot in group)
                            {
                                <div class="mc-availability-slot-row"><span class="mc-availability-slot-time">@FormatTime(slot.StartTime) &ndash; @FormatTime(slot.EndTime)</span><span class="mc-availability-status @(slot.IsBooked ? "mc-availability-status--booked" : "mc-availability-status--available")">@(slot.IsBooked ? "Booked" : "Available")</span></div>
                            }
                        </div>
                    </section>
                }
            }
        </section>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        window.addEventListener('load', function () {
            document.querySelectorAll('[data-auto-dismiss]').forEach(function (alert) {
                if (!alert.textContent.trim()) return;
                window.setTimeout(function () {
                    alert.classList.add('mc-availability-alert--leaving');
                    window.setTimeout(function () { alert.remove(); }, 250);
                }, 5000);
            });
            document.querySelectorAll('.mc-availability-day-toggle').forEach(function (toggle) {
                toggle.addEventListener('click', function () {
                    var content = document.getElementById(toggle.getAttribute('aria-controls'));
                    var shouldOpen = toggle.getAttribute('aria-expanded') !== 'true';
                    document.querySelectorAll('.mc-availability-day-toggle').forEach(function (otherToggle) {
                        var otherContent = document.getElementById(otherToggle.getAttribute('aria-controls'));
                        otherToggle.setAttribute('aria-expanded', 'false');
                        otherContent.hidden = true;
                    });
                    if (shouldOpen) {
                        toggle.setAttribute('aria-expanded', 'true');
                        content.hidden = false;
                    }
                });
            });
        });
    </script>
}
