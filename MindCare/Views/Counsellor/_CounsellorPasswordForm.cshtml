@model MindCare.ViewModels.CounsellorChangePasswordViewModel
@{
    var initial = ViewContext.RouteData.Values["action"]?.ToString() == "ChangeInitialPassword";
    var title = ViewData["SecurityTitle"]?.ToString();
    var formClass = "mc-security-form mc-security-password-form";
}
<section class="mc-security-page" aria-labelledby="security-title">
    <div class="mc-security-card">
        <header class="mc-security-header">
            <span class="mc-security-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 2.8 19 5.7v5.1c0 4.4-2.9 8.4-7 10.4-4.1-2-7-6-7-10.4V5.7l7-2.9Z" /><rect x="9" y="10.4" width="6" height="4.8" rx="1" /><path d="M10.2 10.4V8.8a1.8 1.8 0 0 1 3.6 0v1.6" /></svg></span>
            <p>@ViewData["SecurityEyebrow"]</p>
            <h1 id="security-title">@title</h1>
            <span>@ViewData["SecurityText"]</span>
        </header>
        <aside class="mc-security-info" aria-label="Password security information"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.8 19 5.7v5.1c0 4.4-2.9 8.4-7 10.4-4.1-2-7-6-7-10.4V5.7l7-2.9Z" /><path d="M9 12h6m-3-3v6" /></svg><span>@(ViewData["SecurityInfo"]?.ToString() ?? (initial ? "This temporary password was created when your counsellor account was set up. Choose a private password that only you know." : "Choose a password that is different from your current one and keep it private."))</span></aside>
        <form method="post" class="@formClass">
            <div asp-validation-summary="ModelOnly" class="text-danger mc-security-validation" role="alert"></div>
            <div class="mc-security-field"><label asp-for="CurrentPassword"></label><div class="mc-password-wrap"><input asp-for="CurrentPassword" id="mc-current-password" class="form-control" autocomplete="current-password" /><button type="button" class="mc-password-toggle" data-password-toggle data-show-label="Show current password" data-hide-label="Hide current password" aria-controls="mc-current-password" aria-label="Show current password" aria-pressed="false"><span class="mc-icon-show"><svg class="mc-eye-icon mc-eye-show" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" /><circle cx="12" cy="12" r="3" /></svg></span><span class="mc-icon-hide" hidden><svg class="mc-eye-icon mc-eye-hide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2 2 20 20" /><path d="M6.71 6.71A10.43 10.43 0 0 0 2.06 11.65a1 1 0 0 0 0 .7 10.75 10.75 0 0 0 15.23 5.94" /><path d="M10.73 5.08A10.8 10.8 0 0 1 12 5c4.4 0 8.17 2.65 9.94 6.65a1 1 0 0 1 0 .7 10.5 10.5 0 0 1-2.21 3.31" /><path d="M14.12 14.12A3 3 0 0 1 9.88 9.88" /></svg></span></button></div><span asp-validation-for="CurrentPassword" class="text-danger"></span></div>
            <div class="mc-security-field"><label asp-for="NewPassword"></label><div class="mc-password-wrap"><input asp-for="NewPassword" id="mc-new-password" class="form-control" autocomplete="new-password" /><button type="button" class="mc-password-toggle" data-password-toggle data-show-label="Show new password" data-hide-label="Hide new password" aria-controls="mc-new-password" aria-label="Show new password" aria-pressed="false"><span class="mc-icon-show"><svg class="mc-eye-icon mc-eye-show" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" /><circle cx="12" cy="12" r="3" /></svg></span><span class="mc-icon-hide" hidden><svg class="mc-eye-icon mc-eye-hide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2 2 20 20" /><path d="M6.71 6.71A10.43 10.43 0 0 0 2.06 11.65a1 1 0 0 0 0 .7 10.75 10.75 0 0 0 15.23 5.94" /><path d="M10.73 5.08A10.8 10.8 0 0 1 12 5c4.4 0 8.17 2.65 9.94 6.65a1 1 0 0 1 0 .7 10.5 10.5 0 0 1-2.21 3.31" /><path d="M14.12 14.12A3 3 0 0 1 9.88 9.88" /></svg></span></button></div><small class="mc-security-help">Use at least 6 characters, including uppercase, lowercase, a number, and a special character.</small><span asp-validation-for="NewPassword" class="text-danger"></span></div>
            <div class="mc-security-field"><label asp-for="ConfirmPassword"></label><div class="mc-password-wrap"><input asp-for="ConfirmPassword" id="mc-confirm-password" class="form-control" autocomplete="new-password" /><button type="button" class="mc-password-toggle" data-password-toggle data-show-label="Show confirmation password" data-hide-label="Hide confirmation password" aria-controls="mc-confirm-password" aria-label="Show confirmation password" aria-pressed="false"><span class="mc-icon-show"><svg class="mc-eye-icon mc-eye-show" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" /><circle cx="12" cy="12" r="3" /></svg></span><span class="mc-icon-hide" hidden><svg class="mc-eye-icon mc-eye-hide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2 2 20 20" /><path d="M6.71 6.71A10.43 10.43 0 0 0 2.06 11.65a1 1 0 0 0 0 .7 10.75 10.75 0 0 0 15.23 5.94" /><path d="M10.73 5.08A10.8 10.8 0 0 1 12 5c4.4 0 8.17 2.65 9.94 6.65a1 1 0 0 1 0 .7 10.5 10.5 0 0 1-2.21 3.31" /><path d="M14.12 14.12A3 3 0 0 1 9.88 9.88" /></svg></span></button></div><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
            <div class="mc-security-actions @(initial ? "mc-security-actions--mandatory" : "")"><button type="submit" class="mc-security-primary" data-security-submit><span data-security-submit-label>Change Password</span></button>@if (!initial) { <a asp-action="Profile" class="mc-security-secondary">Cancel</a> }</div>
        </form>
    </div>
</section>
