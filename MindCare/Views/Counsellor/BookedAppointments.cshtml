@model IReadOnlyList<MindCare.Models.Appointment>

@{
    ViewData["Title"] = "Booked Appointments";
    string FormatTime(TimeSpan time) => DateTime.Today.Add(time).ToString("h:mm tt");
    bool HasStarted(Appointment appointment) => DateTime.Now >= appointment.Date.Date.Add(appointment.StartTime);
    bool CanOpenChat(Appointment appointment) =>
        (appointment.Status == AppointmentStatuses.Booked || appointment.Status == AppointmentStatuses.Confirmed) &&
        (appointment.PaymentStatus == PaymentStatuses.Paid || appointment.PaymentStatus == PaymentStatuses.Confirmed) &&
        HasStarted(appointment);
    var groupedAppointments = Model.GroupBy(appointment => appointment.Date.Date).ToList();
    var focusedAppointmentId = ViewData["FocusedAppointmentId"] is int focusedId ? focusedId : (int?)null;
    DateTime? defaultOpenDate = groupedAppointments.FirstOrDefault(group => group.Key >= DateTime.Today)?.Key;
    var focusedGroup = focusedAppointmentId.HasValue ? groupedAppointments.FirstOrDefault(group => group.Any(appointment => appointment.Id == focusedAppointmentId.Value)) : null;
    if (focusedGroup is not null)
    {
        defaultOpenDate = focusedGroup.Key;
    }
    if (defaultOpenDate is null && groupedAppointments.Count > 0)
    {
        defaultOpenDate = groupedAppointments[0].Key;
    }
    var fallbackUrl = Url.Action("Index", "Counsellor")!;
}

<section class="mc-appointments-page" aria-labelledby="appointments-title">
    <div class="mc-appointments-container">
        <header class="mc-appointments-header">
            <div>
                <p class="mc-appointments-eyebrow">Counsellor appointments</p>
                <h1 id="appointments-title">Booked Appointments</h1>
                <p>View your scheduled counselling appointments and session details.</p>
                @if (Model.Count > 0)
                {
                    <span class="mc-appointments-summary">@Model.Count booked appointment@(Model.Count == 1 ? "" : "s")</span>
                }
            </div>
            <button type="button" class="mc-admin-back-button mc-appointments-back" id="mcAppointmentsBack"><span aria-hidden="true">&larr;</span> Back</button>
        </header>

        @if (!Model.Any())
        {
            <section class="mc-appointments-empty-state" aria-labelledby="empty-appointments-title">
                <h2 id="empty-appointments-title">No booked appointments yet</h2>
                <p>Your scheduled counselling appointments will appear here once a session is booked.</p>
                <a asp-action="Availability" class="mc-appointments-empty-action">Manage Availability <span aria-hidden="true">&rarr;</span></a>
            </section>
        }
        else
        {
            <div class="mc-appointments-list">
                @foreach (var group in groupedAppointments)
                {
                    var isOpen = group.Key == defaultOpenDate;
                    var dayId = $"appointment-day-{group.Key:yyyyMMdd}";
                    <section class="mc-appointment-day">
                        <button type="button" class="mc-appointment-day-toggle" aria-expanded="@isOpen.ToString().ToLowerInvariant()" aria-controls="@dayId">
                            <span class="mc-appointment-day-heading">@group.Key.ToString("dd MMMM yyyy")</span>
                            <span class="mc-appointment-day-count">@group.Count() appointment@(group.Count() == 1 ? "" : "s")</span>
                            <svg class="mc-appointment-day-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                        </button>
                        <div id="@dayId" class="mc-appointment-group-list" @(isOpen ? "" : "hidden")>
                            @foreach (var appointment in group)
                            {
                                var isHighPriority = appointment.IsHighPriority || appointment.IsHighRisk || appointment.Priority == AppointmentPriorities.High || string.Equals(appointment.RiskLevel, "High", StringComparison.OrdinalIgnoreCase);
                                <article id="appointment-@appointment.Id" class="mc-appointment-card @(isHighPriority ? "mc-appointment-card--priority" : "") @(appointment.Id == focusedAppointmentId ? "mc-appointment-card--focused" : "")">
                                    <div class="mc-appointment-top">
                                        <time class="mc-appointment-time">@FormatTime(appointment.StartTime) &ndash; @FormatTime(appointment.EndTime)</time>
                                        <div class="mc-appointment-statuses">
                                            @if (appointment.Id == focusedAppointmentId)
                                            {
                                                <span class="mc-appointment-focus-label">Selected from notification</span>
                                            }
                                            @if (isHighPriority)
                                            {
                                                <span class="mc-appointment-priority">High Priority Support</span>
                                            }
                                            <span class="mc-appointment-status">@appointment.Status</span>
                                        </div>
                                    </div>
                                    <dl class="mc-appointment-client-meta">
                                        <div><dt>Client</dt><dd>@appointment.User.Name</dd></div>
                                        <div><dt>Email</dt><dd class="mc-appointment-email">@appointment.User.Email</dd></div>
                                    </dl>
                                    @if (CanOpenChat(appointment))
                                    {
                                        <a asp-controller="Messaging" asp-action="Chat" asp-route-appointmentId="@appointment.Id" class="mc-appointment-chat-action">Open Session Chat <span aria-hidden="true">&rarr;</span></a>
                                    }
                                    else if ((appointment.Status == AppointmentStatuses.Booked || appointment.Status == AppointmentStatuses.Confirmed) && (appointment.PaymentStatus == PaymentStatuses.Paid || appointment.PaymentStatus == PaymentStatuses.Confirmed))
                                    {
                                        <p class="mc-appointment-message-state"><span aria-hidden="true">&#128172;</span> Messaging will be available when your appointment starts.</p>
                                    }
                                </article>
                            }
                        </div>
                    </section>
                }
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        document.getElementById('mcAppointmentsBack').addEventListener('click', function () {
            var fallbackUrl = '@fallbackUrl';
            var hasSameSiteReferrer = false;
            try {
                hasSameSiteReferrer = document.referrer && new URL(document.referrer).origin === window.location.origin;
            } catch (_) { }
            if (hasSameSiteReferrer && window.history.length > 1) {
                window.history.back();
            } else {
                window.location.assign(fallbackUrl);
            }
        });
        document.querySelectorAll('.mc-appointment-day-toggle').forEach(function (toggle) {
            toggle.addEventListener('click', function () {
                var content = document.getElementById(toggle.getAttribute('aria-controls'));
                var shouldOpen = toggle.getAttribute('aria-expanded') !== 'true';
                document.querySelectorAll('.mc-appointment-day-toggle').forEach(function (otherToggle) {
                    var otherContent = document.getElementById(otherToggle.getAttribute('aria-controls'));
                    otherToggle.setAttribute('aria-expanded', 'false');
                    otherContent.hidden = true;
                });
                if (shouldOpen) {
                    toggle.setAttribute('aria-expanded', 'true');
                    content.hidden = false;
                }
            });
        });
    </script>
}
