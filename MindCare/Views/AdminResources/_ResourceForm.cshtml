@model MindCare.ViewModels.ResourceEditViewModel
@{ var isDesignedForm = ViewData["ResourceFormDesign"] as string is "add" or "edit"; var isEdit = ViewData["ResourceFormDesign"] as string == "edit"; var isPublished = ViewData["ResourceStatus"] is MindCare.Models.ResourceStatus.Published; }
@if (isDesignedForm)
{
    <form method="post" class="mc-resource-form mc-resource-form-card">
        <div asp-validation-summary="ModelOnly" class="mc-resource-form-validation" role="alert"></div>
        <section class="mc-resource-form-section" aria-labelledby="basicInformationTitle"><header><p>BASIC INFORMATION</p><h2 id="basicInformationTitle">Resource details</h2></header>
            <div class="mc-resource-form-field"><label asp-for="Title"></label><span class="mc-resource-form-help">@(isEdit ? "Use a clear, concise title for this resource." : "Use a clear, concise title.")</span><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="mc-resource-form-error"></span></div>
            <div class="mc-resource-form-field"><label asp-for="Description">Short description</label><span class="mc-resource-form-help">@(isEdit ? "Give users a quick overview of what this resource covers." : "Write a short introduction that helps users understand the resource.")</span><textarea asp-for="Description" class="form-control" rows="4"></textarea><span asp-validation-for="Description" class="mc-resource-form-error"></span></div>
            <div class="mc-resource-form-field"><label asp-for="CategoryId">Category</label><span class="mc-resource-form-help">@(isEdit ? "Choose the category that best matches this resource." : "Choose the most relevant category.")</span><select asp-for="CategoryId" class="form-select"><option value="">Choose a category</option>@foreach (var c in Model.Categories) { <option value="@c.Id">@c.Name@(c.IsActive ? "" : " (Inactive)")</option> }</select><span asp-validation-for="CategoryId" class="mc-resource-form-error"></span></div>
        </section>
        <section class="mc-resource-form-section" aria-labelledby="resourceContentTitle"><header><p>RESOURCE CONTENT</p><h2 id="resourceContentTitle">@(isEdit ? "Update the resource" : "Write the resource")</h2></header><div class="mc-resource-form-field"><label asp-for="Content"></label><span class="mc-resource-form-help">@(isEdit ? "Update the full resource content." : "Write the full resource content here.")</span><textarea asp-for="Content" class="form-control mc-resource-form-content" rows="14"></textarea><span asp-validation-for="Content" class="mc-resource-form-error"></span></div></section>
        <section class="mc-resource-form-section" aria-labelledby="publishingOptionsTitle"><header><p>PUBLISHING OPTIONS</p><h2 id="publishingOptionsTitle">Visibility and references</h2></header><div class="mc-resource-form-field"><label asp-for="Url">Source URL <small>Optional</small></label><span class="mc-resource-form-help">Add a reliable reference or external source if applicable.</span><input asp-for="Url" class="form-control" /><span asp-validation-for="Url" class="mc-resource-form-error"></span></div><div class="mc-resource-feature-option"><input asp-for="IsFeatured" class="form-check-input" /><div><label asp-for="IsFeatured">Feature this resource when published</label><p>Featured resources may receive more visibility in the resource library.</p></div></div></section>
        <footer class="mc-resource-form-actions"><a asp-action="Index" class="mc-resource-form-cancel">Cancel</a><div>@if (isPublished) { <button name="command" value="save" class="mc-resource-form-publish">Save Changes</button> } else { <button name="command" value="draft" class="mc-resource-form-draft">Save Draft</button><button name="command" value="publish" class="mc-resource-form-publish">@(isEdit ? "Save & Publish" : "Publish Resource")</button> }</div></footer>
    </form>
}
else
{
    <form method="post" class="mc-resource-form"><div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="Title"></label><input asp-for="Title" class="form-control"/><span asp-validation-for="Title" class="text-danger"></span><label asp-for="Description">Short description</label><textarea asp-for="Description" class="form-control" rows="3"></textarea><label asp-for="CategoryId">Category</label><select asp-for="CategoryId" class="form-select"><option value="">Choose a category</option>@foreach(var c in Model.Categories){<option value="@c.Id">@c.Name</option>}</select><label asp-for="Content"></label><textarea asp-for="Content" class="form-control" rows="12"></textarea><span asp-validation-for="Content" class="text-danger"></span><label asp-for="Url">Optional source URL</label><input asp-for="Url" class="form-control"/><div class="form-check mt-3"><input asp-for="IsFeatured" class="form-check-input"/><label asp-for="IsFeatured" class="form-check-label">Feature when published</label></div><div class="mt-4"><button name="command" value="draft" class="btn btn-outline-secondary">Save Draft</button><button name="command" value="publish" class="btn mc-btn-primary">Publish</button><a asp-action="Index" class="btn btn-link">Cancel</a></div></form>
}
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
