@model MindCare.Models.Resource
@{ ViewData["Title"]="Resource Review"; }
<section class="mc-resources-page"><div class="mc-resources-container mc-resource-review"><p class="mc-eyebrow">RESOURCE REVIEW</p><h1>@Model.Title</h1><p>Submitted by @(Model.CreatedByUser?.Name??"Counsellor") · @Model.SubmittedAt?.ToLocalTime().ToString("g")</p><span class="mc-resource-badge">@(Model.ResourceCategory?.Name??Model.Category)</span><p>@Model.Description</p><div class="mc-resource-body">@Model.Content</div><div class="mt-4"><form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button class="btn mc-btn-primary">Approve &amp; Publish</button></form><form asp-action="Reject" method="post" class="mt-3">@Html.AntiForgeryToken()<input name="Id" type="hidden" value="@Model.Id"/><label for="reviewNote">Review note / feedback</label><textarea id="reviewNote" name="ReviewNote" class="form-control" required maxlength="1000"></textarea><button class="btn btn-outline-danger mt-2" onclick="return confirm('Return this resource for revision?');">Reject</button></form></div></div></section>
