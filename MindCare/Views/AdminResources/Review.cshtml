@model MindCare.Models.Resource
@using MindCare.Models
@{
    ViewData["Title"] = "Resource Review";
    var submitterName = Model.CreatedByUser?.Name ?? "Counsellor";
    var submittedAt = Model.SubmittedAt?.ToLocalTime().ToString("dd MMM yyyy · h:mm tt") ?? "Not available";
    var categoryName = Model.ResourceCategory?.Name ?? Model.Category;
    var sourceUrl = Resource.IsSafeExternalUrl(Model.Url) ? Model.Url : null;
}

<section class="mc-resource-review-page">
    <div class="mc-resource-review-container">
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="mc-resource-review-alert" role="alert">@errorMessage</div>
        }
        <header class="mc-resource-review-header">
            <div>
                <p>RESOURCE REVIEW</p>
                <h1>Review Resource</h1>
                <span>Review the counsellor's submission before publishing it to the MindCare Resource Library.</span>
            </div>
            <a asp-action="Pending" class="mc-resource-review-back"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 5-7 7 7 7" /><path d="M7 12h12" /></svg>Back to Pending Reviews</a>
        </header>

        <article class="mc-resource-review-card">
            <header class="mc-resource-review-card-header">
                <span class="mc-resource-review-status">Pending Review</span>
                <h2>@Model.Title</h2>
            </header>
            <dl class="mc-resource-review-meta">
                <div><dt>Submitted by</dt><dd>@submitterName</dd></div>
                <div><dt>Submitted</dt><dd>@submittedAt</dd></div>
                <div><dt>Category</dt><dd><span class="mc-admin-resource-category">@categoryName</span></dd></div>
            </dl>

            <section class="mc-resource-review-section" aria-labelledby="resourceSummary">
                <h3 id="resourceSummary">Summary</h3>
                <p>@Model.Description</p>
            </section>

            <section class="mc-resource-review-section" aria-labelledby="resourceContent">
                <h3 id="resourceContent">Resource Content</h3>
                <div class="mc-resource-review-content">@Model.Content</div>
            </section>

            @if (sourceUrl is not null)
            {
                <section class="mc-resource-review-section mc-resource-review-source" aria-labelledby="resourceSource">
                    <h3 id="resourceSource">Source / Reference</h3>
                    <a href="@sourceUrl" target="_blank" rel="noopener noreferrer">@sourceUrl <span aria-hidden="true">↗</span></a>
                </section>
            }
        </article>

        <section class="mc-resource-review-decision" aria-labelledby="reviewDecision">
            <header>
                <h2 id="reviewDecision">Review Decision</h2>
                <p>Publish this resource when it is ready for the public library, or return it with clear feedback.</p>
            </header>

            <div class="mc-resource-review-approve">
                <div><h3>Ready to publish?</h3><p>Approve this submission to make it available in the MindCare Resource Library.</p></div>
                <form asp-action="Approve" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button class="mc-resource-review-approve-button" type="submit"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4.2 4.2L19 6.5" /></svg>Approve &amp; Publish</button>
                </form>
            </div>

            <form asp-action="Reject" method="post" class="mc-resource-review-feedback">
                @Html.AntiForgeryToken()
                <input name="Id" type="hidden" value="@Model.Id" />
                <div><h3>Return for Revision</h3><p>Provide clear feedback so the counsellor knows what should be improved.</p></div>
                <label for="reviewNote">Review Note / Feedback</label>
                <textarea id="reviewNote" name="ReviewNote" class="form-control" required maxlength="1000" aria-describedby="reviewNoteHelp"></textarea>
                <span id="reviewNoteHelp">Feedback is required to return this resource for revision.</span>
                <button class="mc-resource-review-reject-button" type="submit" onclick="return confirm('Return this resource for revision?');">Reject &amp; Return</button>
            </form>
        </section>
    </div>
</section>
