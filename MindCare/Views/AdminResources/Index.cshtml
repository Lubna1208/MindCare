@model IEnumerable<MindCare.Models.Resource>
@using MindCare.Models
@{
    ViewData["Title"] = "Resource Management";
    var totalCount = Model.Count();
    var publishedCount = Model.Count(r => r.Status == ResourceStatus.Published);
    var pendingCount = Model.Count(r => r.Status == ResourceStatus.PendingReview);
    var draftCount = Model.Count(r => r.Status == ResourceStatus.Draft);
    var archivedCount = Model.Count(r => r.Status == ResourceStatus.Archived);
}
<section class="mc-resources-page mc-admin-resources-page"><div class="mc-resources-container">
    <header class="mc-admin-resources-hero"><div><p class="mc-eyebrow">RESOURCE MANAGEMENT</p><h1>Resources</h1><p>Manage published, pending, archived, and counsellor-submitted resources.</p></div><nav class="mc-admin-resources-actions" aria-label="Resource management actions"><a asp-action="Create" class="btn mc-btn-primary">+ Add Resource</a><a asp-action="Pending" class="btn mc-admin-resources-secondary">Pending Reviews <span>@pendingCount</span></a><a asp-controller="AdminResourceCategories" asp-action="Index" class="btn mc-admin-resources-secondary">Categories</a></nav></header>
    <section class="mc-admin-resource-stats" aria-label="Resource summary"><div class="mc-admin-resource-stat"><span>Total</span><strong>@totalCount</strong></div><div class="mc-admin-resource-stat mc-admin-resource-stat--published"><span>Published</span><strong>@publishedCount</strong></div><div class="mc-admin-resource-stat mc-admin-resource-stat--pending"><span>Pending</span><strong>@pendingCount</strong></div><div class="mc-admin-resource-stat mc-admin-resource-stat--draft"><span>Draft</span><strong>@draftCount</strong></div><div class="mc-admin-resource-stat mc-admin-resource-stat--archived"><span>Archived</span><strong>@archivedCount</strong></div></section>
    <section class="mc-admin-resource-table-card" aria-labelledby="allResourcesTitle"><header class="mc-admin-resource-table-header"><div><h2 id="allResourcesTitle">All Resources</h2><p>Review and manage each resource through its lifecycle.</p></div><span class="mc-admin-resource-table-count">@totalCount resource@(totalCount == 1 ? "" : "s")</span></header>
    @if (!Model.Any()) { <div class="mc-admin-resource-empty"><span class="mc-admin-resource-empty-icon" aria-hidden="true">+</span><h3>No resources found</h3><p>Start building the resource library by adding the first resource.</p><a asp-action="Create" class="btn mc-btn-primary">+ Add Resource</a></div> }
    else { <div class="table-responsive mc-admin-resource-table-scroll"><table class="table mc-resource-table mc-admin-resource-table"><thead><tr><th>Resource</th><th>Category</th><th>Submitted by</th><th>Status</th><th>Featured</th><th>Updated</th><th>Actions</th></tr></thead><tbody>@foreach (var r in Model) { var statusClass = r.Status switch { ResourceStatus.Published => "published", ResourceStatus.PendingReview => "pending", ResourceStatus.Draft => "draft", ResourceStatus.Archived => "archived", ResourceStatus.Rejected => "rejected", _ => "draft" }; var statusText = r.Status == ResourceStatus.PendingReview ? "Pending" : r.Status.ToString(); <tr><td class="mc-admin-resource-title-cell"><strong>@r.Title</strong><span>@r.Description</span></td><td><span class="mc-admin-resource-category">@(r.ResourceCategory?.Name ?? r.Category)</span></td><td class="mc-admin-resource-muted">@(r.CreatedByUser?.Name ?? r.CreatedByRole)</td><td><span class="mc-admin-resource-status mc-admin-resource-status--@statusClass">@statusText</span></td><td>@if (r.IsFeatured) { <span class="mc-admin-resource-featured">Featured</span> } else { <span class="mc-admin-resource-not-featured">Not featured</span> }</td><td class="mc-admin-resource-updated">@r.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy")</td><td><div class="mc-admin-resource-row-actions">@if (r.Status == ResourceStatus.PendingReview) { <a asp-action="Review" asp-route-id="@r.Id" class="mc-admin-resource-action">Review</a> } else if (r.Status == ResourceStatus.Archived) { <form asp-action="Restore" asp-route-id="@r.Id" method="post">@Html.AntiForgeryToken()<button class="mc-admin-resource-action">Restore to draft</button></form> } else { <a asp-action="Edit" asp-route-id="@r.Id" class="mc-admin-resource-action">Edit</a><form asp-action="Archive" asp-route-id="@r.Id" method="post" onsubmit="return confirm('Archive this resource?');">@Html.AntiForgeryToken()<button class="mc-admin-resource-action mc-admin-resource-action--archive">Archive</button></form> }</div></td></tr> }</tbody></table></div> }
    </section>
</div></section>
