@model IEnumerable<MindCare.Models.Resource>
@using MindCare.Models
@{ ViewData["Title"]="Resource Management"; }
<section class="mc-resources-page"><div class="mc-resources-container"><header class="mc-resources-hero"><p class="mc-eyebrow">RESOURCE MANAGEMENT</p><h1>Resources</h1><a asp-action="Create" class="btn mc-btn-primary">+ Add Resource</a> <a asp-action="Pending" class="btn btn-outline-secondary">Pending Reviews (@Model.Count(r=>r.Status==ResourceStatus.PendingReview))</a> <a asp-controller="AdminResourceCategories" asp-action="Index" class="btn btn-outline-secondary">Categories</a></header><div class="mc-resource-summary-row"><span>Total: @Model.Count()</span><span>Published: @Model.Count(r=>r.Status==ResourceStatus.Published)</span><span>Pending: @Model.Count(r=>r.Status==ResourceStatus.PendingReview)</span><span>Draft: @Model.Count(r=>r.Status==ResourceStatus.Draft)</span><span>Archived: @Model.Count(r=>r.Status==ResourceStatus.Archived)</span></div><div class="table-responsive"><table class="table mc-resource-table"><thead><tr><th>Resource</th><th>Category</th><th>Submitted by</th><th>Status</th><th>Featured</th><th>Updated</th><th>Actions</th></tr></thead><tbody>@foreach(var r in Model){<tr><td>@r.Title</td><td>@(r.ResourceCategory?.Name??r.Category)</td><td>@(r.CreatedByUser?.Name??r.CreatedByRole)</td><td>@r.Status</td><td>@(r.IsFeatured?"Yes":"—")</td><td>@r.UpdatedAt.ToLocalTime().ToString("d")</td><td>@if(r.Status==ResourceStatus.PendingReview){<a asp-action="Review" asp-route-id="@r.Id">Review</a>}else if(r.Status==ResourceStatus.Archived){<form asp-action="Restore" asp-route-id="@r.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button class="btn btn-link">Restore to draft</button></form>}else{<a asp-action="Edit" asp-route-id="@r.Id">Edit</a><form asp-action="Archive" asp-route-id="@r.Id" method="post" class="d-inline" onsubmit="return confirm('Archive this resource?');">@Html.AntiForgeryToken()<button class="btn btn-link">Archive</button></form>}</td></tr>}</tbody></table></div></div></section>
