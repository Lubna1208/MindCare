@model MindCare.Models.Resource

@{
    ViewData["Title"] = Model.Title;
}

<section class="mc-resource-detail-page">
    <div class="mc-resource-detail-container">
        <a asp-action="Index" class="mc-resource-back"><span aria-hidden="true">&larr;</span> Back to Resources</a>

        <article class="mc-resource-details-card">
            <header class="mc-resource-header">
                <span class="mc-resource-category">@Model.Category</span>
                <h1 class="mc-resource-detail-title">@Model.Title</h1>
                <p class="mc-resource-summary">@Model.Description</p>
                <p class="mc-resource-meta mb-0">Added @Model.CreatedAt.ToLocalTime().ToString("dd MMMM yyyy")</p>
            </header>

            @if (!string.IsNullOrWhiteSpace(Model.Content))
            {
                <section class="mc-resource-content" aria-labelledby="resource-content-title">
                    <h2 id="resource-content-title">Overview</h2>
                    <div class="mc-resource-body">@Model.Content</div>
                </section>
            }

            @if (Resource.IsSafeExternalUrl(Model.Url))
            {
                <a href="@Model.Url" target="_blank" rel="noopener noreferrer" class="btn mc-btn-primary">Open External Resource</a>
            }
        </article>
    </div>
</section>
