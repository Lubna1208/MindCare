@model MindCare.Models.Resource

@{
    ViewData["Title"] = Model.Title;
}

<div class="mc-resource-details-page">
    <a asp-action="Index" class="mc-back-link">Back to Resources</a>

    <article class="mc-resource-details-card">
        <span class="mc-resource-badge">@Model.Category</span>
        <h1 class="mc-page-title mt-3 mb-3">@Model.Title</h1>
        <p class="mc-resource-details-summary">@Model.Description</p>

        @if (!string.IsNullOrWhiteSpace(Model.Content))
        {
            <section class="mc-resource-reading" aria-labelledby="resource-content-title">
                <h2 id="resource-content-title" class="mc-section-title">Resource</h2>
                <div>@Model.Content</div>
            </section>
        }

        @if (Resource.IsSafeExternalUrl(Model.Url))
        {
            <a href="@Model.Url" target="_blank" rel="noopener noreferrer" class="btn mc-btn-primary">Open External Resource</a>
        }
        <p class="text-muted small mt-4 mb-0">Added @Model.CreatedAt.ToLocalTime().ToString("dd MMMM yyyy")</p>
    </article>
</div>
