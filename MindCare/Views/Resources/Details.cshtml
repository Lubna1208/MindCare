@model MindCare.Models.Resource

@{
    ViewData["Title"] = Model.Title;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@Model.Title</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Resources</a>
</div>

<article class="card shadow-sm">
    <div class="card-body">
        <p><span class="badge text-bg-light border">@Model.Category</span></p>
        <p class="lead">@Model.Description</p>

        @if (!string.IsNullOrWhiteSpace(Model.Content))
        {
            <section class="mb-4">
                <h2 class="h5">Resource</h2>
                <p class="mb-0" style="white-space: pre-line">@Model.Content</p>
            </section>
        }

        @if (Resource.IsSafeExternalUrl(Model.Url))
        {
            <a href="@Model.Url" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Open External Resource</a>
        }

        <p class="text-muted small mt-4 mb-0">Added @Model.CreatedAt.ToLocalTime().ToString("dd MMMM yyyy")</p>
    </div>
</article>

@* Resource page branch update - no functional changes *@