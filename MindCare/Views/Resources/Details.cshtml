@model MindCare.ViewModels.ResourceDetailsViewModel
@using MindCare.Models
@{ var resource = Model.Resource; ViewData["Title"] = resource.Title; var canSummarize = User.IsInRole(RoleNames.User) && !string.IsNullOrWhiteSpace(resource.Content); }
<section class="mc-resource-detail-page"><div class="mc-resource-detail-container">
    <a asp-action="Index" class="mc-resource-back">← Back to Resources</a>
    <article class="mc-resource-details-card">
        <span class="mc-resource-category">@(resource.ResourceCategory?.Name ?? resource.Category)</span>
        <h1 class="mc-resource-detail-title">@resource.Title</h1><p class="mc-resource-summary">@resource.Description</p>
        <p class="mc-resource-meta">@Math.Max(1, (resource.Content ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).Length / 200) min read</p>
        @if (User.IsInRole(RoleNames.User)) { <form asp-action="ToggleBookmark" asp-route-id="@resource.Id" asp-route-returnUrl="@Context.Request.Path" method="post">@Html.AntiForgeryToken()<button class="btn mc-btn-primary">@(Model.IsBookmarked ? "Saved" : "Save Resource")</button></form> }
        @if (canSummarize) { <section class="mc-resource-ai" data-resource-ai data-summary-endpoint="/AI/Resources/@resource.Id/Summarize">@Html.AntiForgeryToken()<button type="button" class="mc-resource-ai-button" data-resource-ai-button><span data-resource-ai-label>Summarize with AI</span></button><p data-resource-ai-status></p><section data-resource-ai-card hidden><h2>AI Summary</h2><p data-resource-ai-summary></p><ul data-resource-ai-points></ul></section></section> }
        <section class="mc-resource-content"><h2>Overview</h2><div class="mc-resource-body">@resource.Content</div></section>
    </article>
    @if (Model.Related.Any()) { <section><h2>You may also find helpful</h2><div class="mc-resources-grid">@foreach (var related in Model.Related) { <article class="mc-resource-card"><h3>@related.Title</h3><p>@related.Description</p><a asp-action="Details" asp-route-id="@related.Id">Read Resource</a></article> }</div></section> }
</div></section>
@if (canSummarize)
{
    @section Scripts { <script src="~/js/ai-resource-summary.js" asp-append-version="true"></script> }
}
